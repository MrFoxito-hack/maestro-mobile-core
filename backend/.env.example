EMS_EXECUTION_MODE=simulated
# Separate design/runtime store; defaults to laboratory.db beside EMS_DATABASE_PATH.
# API, worker and watchdog must use the same local path. Only dry_run is enabled.
# EMS_LABORATORY_DATABASE_PATH=./data/laboratory.db
# Optional local-only tutor: install Ollama and the admitted model separately.
# Uses 127.0.0.1:11434, no cloud fallback. Does not start with a Core acquisition.
EMS_LABORATORY_AI_ENABLED=false
EMS_SECRET_KEY=replace-with-a-long-random-value

# VirtualBox NAT: host 127.0.0.1:2222 -> guest:22
EMS_TESTBED_HOST=127.0.0.1
EMS_SSH_PORT=2222
EMS_SSH_USER=emsadmin
EMS_SSH_PASSWORD=
EMS_SSH_STRICT_HOST_KEY=false

EMS_ENABLE_REAL_CAPTURES=false
EMS_METRICS_COLLECTION_INTERVAL_SECONDS=10
EMS_METRICS_RETENTION_DAYS=30
EMS_OPEN5GS_INFO_PORT=9090
EMS_OPERATION_OUTPUT_LIMIT=100000
EMS_ALLOWED_INTERFACES=["lo","ogstun","enp0s3","any"]
EMS_ENABLE_MONGO=false
EMS_CHF_MANAGEMENT_ENABLED=false
EMS_CHF_MANAGEMENT_PORT=8082
EMS_CHF_READER_TOKEN_FILE=/home/emsadmin/maestro-charging/management/reader.token
