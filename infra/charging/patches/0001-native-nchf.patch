diff --git a/src/smf/chf-build.c b/src/smf/chf-build.c
new file mode 100644
index 0000000..a1da346
--- /dev/null
+++ b/src/smf/chf-build.c
@@ -0,0 +1,130 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * TS 32.291 V16.17.0, 6.1: explicit supported volume-charging subset.
+ * Uses cJSON for this new service; no shell, synchronous HTTP or fake traffic.
+ */
+#include "chf-path.h"
+
+ogs_sbi_request_t *smf_chf_build_create(smf_sess_t *sess)
+{
+    ogs_chf_config_t *config = &smf_self()->chf_config;
+    smf_ue_t *ue = smf_ue_find_by_id(sess->smf_ue_id);
+    ogs_sbi_request_t *request;
+    ogs_sbi_header_t header;
+    cJSON *root, *nf, *pdu, *info, *slice, *snssai, *usage, *unit, *requested;
+    char *timestamp, *notify, *body, *authorization;
+    char sd[7];
+    if (!ue || !ue->supi || !sess->chf || !sess->session.name ||
+            !ogs_sbi_server_first()) return NULL;
+
+    root = cJSON_CreateObject();
+    ogs_assert(root);
+    timestamp = ogs_sbi_gmtime_string(ogs_time_now());
+    cJSON_AddStringToObject(root, "subscriberIdentifier", ue->supi);
+    cJSON_AddNumberToObject(root, "chargingId", sess->chf->charging_id);
+    cJSON_AddStringToObject(root, "invocationTimeStamp", timestamp);
+    cJSON_AddNumberToObject(root, "invocationSequenceNumber", sess->chf->sequence_number);
+    ogs_free(timestamp);
+    nf = cJSON_AddObjectToObject(root, "nfConsumerIdentification");
+    cJSON_AddStringToObject(nf, "nFName", ogs_sbi_self()->nf_instance->id);
+    cJSON_AddStringToObject(nf, "nodeFunctionality", "SMF");
+
+    memset(&header, 0, sizeof(header));
+    header.service.name = (char *)"nchf-convergedcharging-notify";
+    header.api.version = (char *)"v1";
+    header.resource.component[0] = (char *)"notify";
+    notify = ogs_sbi_server_uri(ogs_sbi_server_first(), &header);
+    cJSON_AddStringToObject(root, "notifyUri", notify);
+    ogs_free(notify);
+
+    pdu = cJSON_AddObjectToObject(root, "pDUSessionChargingInformation");
+    cJSON_AddNumberToObject(pdu, "chargingId", sess->chf->charging_id);
+    info = cJSON_AddObjectToObject(pdu, "pduSessionInformation");
+    cJSON_AddNumberToObject(info, "pduSessionID", sess->psi);
+    cJSON_AddStringToObject(info, "dnnId", sess->session.name);
+    slice = cJSON_AddObjectToObject(info, "networkSlicingInfo");
+    snssai = cJSON_AddObjectToObject(slice, "sNSSAI");
+    cJSON_AddNumberToObject(snssai, "sst", sess->s_nssai.sst);
+    if (sess->s_nssai.sd.v != OGS_S_NSSAI_NO_SD_VALUE) {
+        ogs_snprintf(sd, sizeof(sd), "%06x", sess->s_nssai.sd.v);
+        cJSON_AddStringToObject(snssai, "sd", sd);
+    }
+
+    usage = cJSON_AddArrayToObject(root, "multipleUnitUsage");
+    unit = cJSON_CreateObject();
+    cJSON_AddItemToArray(usage, unit);
+    cJSON_AddNumberToObject(unit, "ratingGroup", sess->chf->rating_group);
+    requested = cJSON_AddObjectToObject(unit, "requestedUnit");
+    cJSON_AddNumberToObject(requested, "totalVolume", config->requested_units);
+    body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) return NULL;
+
+    request = ogs_sbi_request_new();
+    if (!request) { cJSON_free(body); return NULL; }
+    request->h.method = ogs_strdup(OGS_SBI_HTTP_METHOD_POST);
+    request->h.uri = ogs_msprintf("http://%s:%u%s", config->addr,
+            config->port, SMF_CHF_COLLECTION);
+    request->http.content = ogs_strdup(body);
+    request->http.content_length = strlen(body);
+    cJSON_free(body);
+    request->deadline = ogs_time_from_msec(config->timeout_ms);
+    ogs_sbi_header_set(request->http.headers, OGS_SBI_CONTENT_TYPE, "application/json");
+    ogs_sbi_header_set(request->http.headers, OGS_SBI_ACCEPT, "application/json, application/problem+json");
+    if (!config->lab_no_auth) {
+        authorization = ogs_msprintf("Bearer %s", getenv(config->token_env));
+        ogs_sbi_header_set(request->http.headers, "authorization", authorization);
+        ogs_free(authorization);
+    }
+    return request;
+}
+
+ogs_sbi_request_t *smf_chf_build_change(smf_sess_t *sess,
+        smf_chf_operation_e operation, const smf_chf_usage_t *usage)
+{
+    ogs_sbi_request_t *request;
+    cJSON *root, *unit, *used, *container, *triggers, *trigger;
+    char *body;
+    const char *reason = usage ? usage->trigger : "FINAL";
+    if (!sess->chf || !sess->chf->resource_uri ||
+            (operation != SMF_CHF_UPDATE && operation != SMF_CHF_RELEASE)) return NULL;
+    if (operation == SMF_CHF_UPDATE && !usage) return NULL;
+    if (usage && (usage->uplink > 9007199254740991ULL ||
+                usage->downlink > 9007199254740991ULL - usage->uplink)) return NULL;
+    if (!reason || (strcmp(reason, "QUOTA_THRESHOLD") && strcmp(reason, "QUOTA_EXHAUSTED") &&
+                strcmp(reason, "VALIDITY_TIME") && strcmp(reason, "FINAL") &&
+                strcmp(reason, "ABNORMAL_RELEASE"))) return NULL;
+    request = smf_chf_build_create(sess);
+    if (!request) return NULL;
+    root = cJSON_Parse(request->http.content);
+    if (!root) { ogs_sbi_request_free(request); return NULL; }
+    cJSON_DeleteItemFromObjectCaseSensitive(root, "notifyUri");
+    unit = cJSON_GetArrayItem(cJSON_GetObjectItemCaseSensitive(root, "multipleUnitUsage"), 0);
+    if (operation == SMF_CHF_RELEASE)
+        cJSON_DeleteItemFromObjectCaseSensitive(unit, "requestedUnit");
+    if (usage) {
+        used = cJSON_AddArrayToObject(unit, "usedUnitContainer");
+        container = cJSON_CreateObject();
+        cJSON_AddItemToArray(used, container);
+        cJSON_AddNumberToObject(container, "localSequenceNumber", usage->sequence);
+        cJSON_AddNumberToObject(container, "totalVolume", usage->uplink + usage->downlink);
+        cJSON_AddNumberToObject(container, "uplinkVolume", usage->uplink);
+        cJSON_AddNumberToObject(container, "downlinkVolume", usage->downlink);
+        cJSON_AddStringToObject(container, "quotaManagementIndicator", "ONLINE_CHARGING");
+    }
+    triggers = cJSON_AddArrayToObject(root, "triggers");
+    trigger = cJSON_CreateObject();
+    cJSON_AddItemToArray(triggers, trigger);
+    cJSON_AddStringToObject(trigger, "triggerType", reason);
+    cJSON_AddStringToObject(trigger, "triggerCategory", "IMMEDIATE_REPORT");
+    body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) { ogs_sbi_request_free(request); return NULL; }
+    ogs_free(request->http.content);
+    request->http.content = ogs_strdup(body);
+    request->http.content_length = strlen(body);
+    cJSON_free(body);
+    ogs_free(request->h.uri);
+    request->h.uri = ogs_msprintf("%s/%s", sess->chf->resource_uri,
+            operation == SMF_CHF_UPDATE ? "update" : "release");
+    return request;
+}
diff --git a/src/smf/chf-config.c b/src/smf/chf-config.c
new file mode 100644
index 0000000..80595de
--- /dev/null
+++ b/src/smf/chf-config.c
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * MAEstro experimental TS 32.291 Rel16 volume-charging profile.
+ */
+#include "chf-path.h"
+#include <errno.h>
+#include <ctype.h>
+
+void smf_chf_config_init(ogs_chf_config_t *config)
+{
+    memset(config, 0, sizeof(*config));
+    config->port = 8081;
+    config->timeout_ms = 2000;
+    config->retries = 2;
+    config->rating_group = 1;
+    config->requested_units = 1048576;
+    config->token_env = "SMF_CHF_TOKEN";
+    config->journal_dir = "./chf-journal";
+}
+
+static bool parse_uint(ogs_yaml_iter_t *iter, uint64_t min,
+        uint64_t max, uint64_t *out)
+{
+    const char *value = ogs_yaml_iter_value(iter);
+    const char *p;
+    char *end = NULL;
+    unsigned long long number;
+    if (!value || !*value) return false;
+    for (p = value; *p; p++)
+        if (!isdigit((unsigned char)*p)) return false;
+    errno = 0;
+    number = strtoull(value, &end, 10);
+    if (errno || *end || number < min || number > max) return false;
+    *out = number;
+    return true;
+}
+
+static bool parse_bool(ogs_yaml_iter_t *iter, bool *out)
+{
+    const char *value = ogs_yaml_iter_value(iter);
+    if (value && !strcmp(value, "true")) { *out = true; return true; }
+    if (value && !strcmp(value, "false")) { *out = false; return true; }
+    return false;
+}
+
+static int parse_endpoint(ogs_yaml_iter_t *iter, ogs_chf_config_t *c)
+{
+    ogs_yaml_iter_t array, endpoint;
+    uint64_t number;
+    int count = 0;
+    ogs_yaml_iter_recurse(iter, &array);
+    if (ogs_yaml_iter_type(&array) != YAML_SEQUENCE_NODE) goto invalid;
+    while (ogs_yaml_iter_next(&array)) {
+        if (++count != 1) goto invalid; /* Failover not yet implemented. */
+        ogs_yaml_iter_recurse(&array, &endpoint);
+        if (ogs_yaml_iter_type(&endpoint) != YAML_MAPPING_NODE) goto invalid;
+        while (ogs_yaml_iter_next(&endpoint)) {
+            const char *key = ogs_yaml_iter_key(&endpoint);
+            if (!strcmp(key, "addr")) c->addr = ogs_yaml_iter_value(&endpoint);
+            else if (!strcmp(key, "port")) {
+                if (!parse_uint(&endpoint, 1, 65535, &number)) goto invalid;
+                c->port = number;
+            } else goto invalid;
+        }
+    }
+    if (count == 1) return OGS_OK;
+invalid:
+    ogs_error("smf.chf.sbi requires exactly one {addr, port} endpoint");
+    return OGS_ERROR;
+}
+
+int smf_chf_config_parse(ogs_yaml_iter_t *iter)
+{
+    ogs_chf_config_t *c = &smf_self()->chf_config;
+    ogs_yaml_iter_t child;
+    uint64_t number;
+    bool enabled_seen = false;
+    ogs_yaml_iter_recurse(iter, &child);
+    if (ogs_yaml_iter_type(&child) != YAML_MAPPING_NODE) goto invalid;
+    /* Explicit false ignores all remaining CHF settings, without DNS/client I/O. */
+    while (ogs_yaml_iter_next(&child)) {
+        if (!strcmp(ogs_yaml_iter_key(&child), "enabled")) {
+            if (enabled_seen || !parse_bool(&child, &c->enabled)) goto invalid;
+            enabled_seen = true;
+        }
+    }
+    if (!enabled_seen) goto invalid;
+    if (!c->enabled) return OGS_OK;
+    ogs_yaml_iter_recurse(iter, &child);
+    while (ogs_yaml_iter_next(&child)) {
+        const char *key = ogs_yaml_iter_key(&child);
+        if (!strcmp(key, "enabled")) continue;
+        if (!strcmp(key, "sbi")) {
+            if (parse_endpoint(&child, c) != OGS_OK) return OGS_ERROR;
+        } else if (!strcmp(key, "timeout_ms")) {
+            if (!parse_uint(&child, 100, 30000, &number)) goto invalid;
+            c->timeout_ms = number;
+        } else if (!strcmp(key, "retries")) {
+            if (!parse_uint(&child, 0, 5, &number)) goto invalid;
+            c->retries = number;
+        } else if (!strcmp(key, "rating_group")) {
+            if (!parse_uint(&child, 0, UINT32_MAX, &number)) goto invalid;
+            c->rating_group = number;
+        } else if (!strcmp(key, "requested_units")) {
+            if (!parse_uint(&child, 1, UINT32_MAX, &number)) goto invalid;
+            c->requested_units = number;
+        } else if (!strcmp(key, "token_env")) {
+            c->token_env = ogs_yaml_iter_value(&child);
+        } else if (!strcmp(key, "journal_dir")) {
+            c->journal_dir = ogs_yaml_iter_value(&child);
+            if (!c->journal_dir || !*c->journal_dir) goto invalid;
+        } else if (!strcmp(key, "nf_instance_id")) {
+            c->nf_instance_id = ogs_yaml_iter_value(&child);
+        } else if (!strcmp(key, "lab_no_auth")) {
+            if (!parse_bool(&child, &c->lab_no_auth)) goto invalid;
+        } else goto invalid;
+    }
+    return OGS_OK;
+invalid:
+    ogs_error("Invalid smf.chf configuration (unsupported key or value)");
+    return OGS_ERROR;
+}
+
+int smf_chf_config_validate(ogs_chf_config_t *c)
+{
+    struct in_addr addr;
+    ogs_uuid_t uuid;
+    const char *token;
+    if (!c->enabled) return OGS_OK;
+    /* First native profile: static IPv4 endpoint over isolated lab HTTP/2. */
+    if (!c->addr || inet_pton(AF_INET, c->addr, &addr) != 1) {
+        ogs_error("smf.chf.sbi.addr must be an IPv4 address");
+        return OGS_ERROR;
+    }
+    if (c->nf_instance_id && ogs_uuid_parse(&uuid, c->nf_instance_id) != OGS_OK) {
+        ogs_error("smf.chf.nf_instance_id must be a UUID");
+        return OGS_ERROR;
+    }
+    token = c->token_env ? getenv(c->token_env) : NULL;
+    if (!c->lab_no_auth && (!token || strlen(token) < 32 ||
+                strchr(token, '\r') || strchr(token, '\n'))) {
+        ogs_error("CHF bearer credential missing or invalid in environment");
+        return OGS_ERROR;
+    }
+    if (c->lab_no_auth)
+        ogs_warn("CHF lab_no_auth enabled: isolated laboratory ONLY");
+    return OGS_OK;
+}
diff --git a/src/smf/chf-path.c b/src/smf/chf-path.c
new file mode 100644
index 0000000..e9d4c55
--- /dev/null
+++ b/src/smf/chf-path.c
@@ -0,0 +1,418 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Native asynchronous Nchf client for MAEstro's experimental Rel16 profile.
+ */
+#include "chf-path.h"
+#include <math.h>
+#include <unistd.h>
+
+OGS_STATIC_ASSERT(sizeof(uint64_t) == sizeof(double));
+
+static ogs_sbi_client_t *chf_client;
+static uint64_t generation;
+static int client_callback(int status, ogs_sbi_response_t *response, void *data);
+
+int smf_chf_open(void)
+{
+    ogs_chf_config_t *config = &smf_self()->chf_config;
+    ogs_sockaddr_t *addr = NULL;
+    if (!config->enabled) return OGS_OK;
+    if (ogs_getaddrinfo(&addr, AF_INET, config->addr, config->port, 0) != OGS_OK)
+        return OGS_ERROR;
+    chf_client = ogs_sbi_client_add(OpenAPI_uri_scheme_http, NULL, 0, addr, NULL);
+    ogs_freeaddrinfo(addr);
+    if (!chf_client) return OGS_ERROR;
+    if (config->nf_instance_id) {
+        /* Configure the ACTUAL SMF identity before NRF registration, not a fake owner. */
+        ogs_sbi_nf_instance_t *nf = ogs_sbi_self()->nf_instance;
+        ogs_assert(ogs_uuid_parse(&ogs_sbi_self()->uuid, config->nf_instance_id) == OGS_OK);
+        ogs_free(nf->id);
+        ogs_sbi_nf_instance_set_id(nf, (char *)config->nf_instance_id);
+    }
+    ogs_info("Experimental Nchf volume profile enabled (static direct HTTP/2)");
+    return OGS_OK;
+}
+
+void smf_chf_sess_clear(smf_sess_t *sess)
+{
+    if (!sess->chf) return;
+    smf_chf_context_unref(sess->chf);
+    sess->chf = NULL;
+}
+
+void smf_chf_context_unref(smf_chf_sess_t *chf)
+{
+    if (chf->refs > 1) { chf->refs--; return; }
+    if (chf->resource_uri && !chf->closed) {
+        ogs_warn("CHF context removed without Release; reservation requires reconciliation");
+        smf_chf_journal(chf, "reconciliation_required", NULL, NULL, 0);
+    }
+    if (chf->release_request) ogs_sbi_request_free(chf->release_request);
+    if (chf->resource_uri) ogs_free(chf->resource_uri);
+    if (chf->charging_session_id) ogs_free(chf->charging_session_id);
+    if (chf->journal_path) {
+        close(chf->journal_fd);
+        ogs_free(chf->journal_path);
+    }
+    ogs_free(chf);
+}
+
+void smf_chf_transaction_free(smf_chf_transaction_t *transaction)
+{
+    if (transaction->request) ogs_sbi_request_free(transaction->request);
+    if (transaction->owner) smf_chf_context_unref(transaction->owner);
+    ogs_free(transaction);
+}
+
+static int client_callback(int status, ogs_sbi_response_t *response, void *data)
+{
+    smf_chf_transaction_t *transaction = data;
+    smf_event_t *event;
+    smf_sess_t *sess = smf_sess_find_by_id(transaction->sess_id);
+    bool live = sess && sess->chf && sess->chf->generation == transaction->generation;
+    bool retryable = status == OGS_ERROR || status == OGS_TIMEUP ||
+        (response && (response->status == 503 || response->status == 504));
+    if ((live || transaction->owner) && retryable && transaction->retries < smf_self()->chf_config.retries) {
+        transaction->retries++;
+        /* Exactly the same sequence, timestamp and payload on every retry. */
+        if (ogs_sbi_client_send_request(chf_client, client_callback,
+                    transaction->request, transaction)) {
+            if (response) ogs_sbi_response_free(response);
+            return OGS_OK;
+        }
+    }
+    if (status == OGS_DONE) { /* shutdown, event loop has terminated */
+        if (transaction->owner)
+            smf_chf_journal(transaction->owner, "shutdown_pending", NULL, NULL, status);
+        if (response) ogs_sbi_response_free(response);
+        smf_chf_transaction_free(transaction);
+        return OGS_OK;
+    }
+    event = smf_event_new(SMF_EVT_CHF_RESPONSE);
+    event->sess_id = transaction->sess_id;
+    event->h.sbi.data = transaction;
+    event->h.sbi.response = response;
+    event->h.sbi.state = status;
+    if (ogs_queue_push(ogs_app()->queue, event) != OGS_OK) {
+        if (response) ogs_sbi_response_free(response);
+        smf_chf_transaction_free(transaction);
+        ogs_event_free(event);
+        ogs_error("CHF response delivery failed; reconciliation required");
+        return OGS_ERROR;
+    }
+    ogs_pollset_notify(ogs_app()->pollset);
+    return OGS_OK;
+}
+
+int smf_chf_send_create(smf_sess_t *sess)
+{
+    smf_chf_transaction_t *transaction;
+    if (!smf_self()->chf_config.enabled || !chf_client || sess->epc || sess->chf)
+        return OGS_ERROR;
+    sess->chf = ogs_calloc(1, sizeof(*sess->chf));
+    ogs_assert(sess->chf);
+    sess->chf->refs = 1;
+    if (smf_chf_journal_open(sess->chf) != OGS_OK) {
+        ogs_error("Cannot open private CHF journal; Create blocked");
+        smf_chf_sess_clear(sess);
+        return OGS_ERROR;
+    }
+    sess->chf->generation = ++generation;
+    if (smf_chf_allocate_id(ogs_sbi_self()->nf_instance->id,
+                &sess->chf->charging_id) != OGS_OK) {
+        ogs_error("Durable chargingId allocation failed; Create blocked");
+        smf_chf_sess_clear(sess);
+        return OGS_ERROR;
+    }
+    sess->chf->rating_group = smf_self()->chf_config.rating_group;
+    sess->chf->sequence_number = 1;
+    transaction = ogs_calloc(1, sizeof(*transaction));
+    ogs_assert(transaction);
+    transaction->sess_id = sess->id;
+    transaction->generation = sess->chf->generation;
+    transaction->operation = SMF_CHF_CREATE;
+    transaction->owner = sess->chf;
+    sess->chf->refs++;
+    transaction->request = smf_chf_build_create(sess);
+    if (!transaction->request || smf_chf_journal(sess->chf, "request",
+                transaction->request->h.uri, transaction->request->http.content, 0) != OGS_OK ||
+            !ogs_sbi_client_send_request(chf_client,
+                client_callback, transaction->request, transaction)) {
+        smf_chf_transaction_free(transaction);
+        return OGS_ERROR;
+    }
+    sess->chf->pending = true;
+    return OGS_OK;
+}
+
+int smf_chf_send_change(smf_sess_t *sess,
+        smf_chf_operation_e operation, const smf_chf_usage_t *usage)
+{
+    smf_chf_transaction_t *transaction;
+    smf_chf_sess_t *chf = sess->chf;
+    if (!smf_self()->chf_config.enabled || !chf_client || !chf ||
+            !chf->resource_uri || chf->closed || chf->uncertain || chf->pending ||
+            chf->sequence_number == UINT32_MAX ||
+            (operation != SMF_CHF_UPDATE && operation != SMF_CHF_RELEASE)) return OGS_ERROR;
+    if (usage && (usage->uplink > 9007199254740991ULL ||
+                usage->downlink > 9007199254740991ULL - usage->uplink ||
+                chf->consumed_units > 9007199254740991ULL - usage->uplink - usage->downlink ||
+                (chf->has_usage_sequence && usage->sequence <= chf->usage_sequence_number)))
+        return OGS_ERROR;
+    transaction = ogs_calloc(1, sizeof(*transaction));
+    ogs_assert(transaction);
+    transaction->sess_id = sess->id;
+    transaction->generation = chf->generation;
+    transaction->operation = operation;
+    transaction->owner = chf;
+    chf->refs++;
+    if (usage) {
+        transaction->has_usage = true;
+        transaction->used_units = usage->uplink + usage->downlink;
+        transaction->usage_sequence = usage->sequence;
+    }
+    chf->sequence_number++;
+    transaction->request = smf_chf_build_change(sess, operation, usage);
+    if (!transaction->request) {
+        chf->sequence_number--; /* No request sent. */
+        smf_chf_transaction_free(transaction);
+        return OGS_ERROR;
+    }
+    if (smf_chf_journal(chf, "request", transaction->request->h.uri,
+                transaction->request->http.content, 0) != OGS_OK ||
+            !ogs_sbi_client_send_request(chf_client, client_callback, transaction->request, transaction)) {
+        chf->uncertain = true;
+        smf_chf_transaction_free(transaction);
+        return OGS_ERROR;
+    }
+    chf->pending = true;
+    return OGS_OK;
+}
+
+static bool json_uint(cJSON *object, const char *key, uint64_t max, uint64_t *out)
+{
+    cJSON *value = cJSON_GetObjectItemCaseSensitive(object, key);
+    double number;
+    uint64_t bits;
+    if (!cJSON_IsNumber(value)) return false;
+    number = value->valuedouble;
+    /* Upstream uses -ffast-math: test IEEE exponent bits, not isfinite(). */
+    memcpy(&bits, &number, sizeof(bits));
+    if ((bits & 0x7ff0000000000000ULL) == 0x7ff0000000000000ULL ||
+            number < 0 || number > (double)max || floor(number) < number)
+        return false;
+    *out = (uint64_t)number;
+    return true;
+}
+
+bool smf_chf_handle_response(smf_sess_t *sess, smf_event_t *event)
+{
+    ogs_sbi_response_t *response = event->h.sbi.response;
+    smf_chf_transaction_t *transaction = event->h.sbi.data;
+    smf_chf_operation_e operation = transaction ? transaction->operation : SMF_CHF_CREATE;
+    cJSON *root = NULL, *units, *unit, *grant, *result, *final, *action;
+    uint64_t sequence, rating_group, granted, validity;
+    const char *location, *path, *ref;
+    char *origin = NULL;
+    ogs_uuid_t uuid;
+    bool valid = false;
+    if (operation == SMF_CHF_RELEASE) {
+        if (smf_chf_release_confirmed(event->h.sbi.state, response)) {
+            sess->chf->closed = true;
+            sess->chf->granted_units = 0;
+            valid = true;
+        }
+        goto done;
+    }
+    if (operation != SMF_CHF_CREATE && operation != SMF_CHF_UPDATE) goto done;
+    if (event->h.sbi.state != OGS_OK || !response ||
+            response->status != (operation == SMF_CHF_CREATE ? 201 : 200) ||
+            !response->http.content || response->http.content_length > 262144)
+        goto done;
+    root = cJSON_ParseWithLength(response->http.content, response->http.content_length);
+    if (!cJSON_IsObject(root) || !json_uint(root, "invocationSequenceNumber", UINT32_MAX, &sequence) ||
+            sequence != sess->chf->sequence_number) goto done;
+    units = cJSON_GetObjectItemCaseSensitive(root, "multipleUnitInformation");
+    if (!cJSON_IsArray(units) || cJSON_GetArraySize(units) != 1) goto done;
+    unit = cJSON_GetArrayItem(units, 0);
+    grant = cJSON_GetObjectItemCaseSensitive(unit, "grantedUnit");
+    result = cJSON_GetObjectItemCaseSensitive(unit, "resultCode");
+    if (!json_uint(unit, "ratingGroup", UINT32_MAX, &rating_group) ||
+            rating_group != sess->chf->rating_group ||
+            !json_uint(grant, "totalVolume", 9007199254740991ULL, &granted) ||
+            granted > smf_self()->chf_config.requested_units ||
+            !json_uint(unit, "validityTime", UINT32_MAX, &validity) || !validity ||
+            !cJSON_IsString(result)) goto done;
+    if (granted && strcmp(result->valuestring, "SUCCESS")) goto done;
+    final = cJSON_GetObjectItemCaseSensitive(unit, "finalUnitIndication");
+    if (final) {
+        action = cJSON_GetObjectItemCaseSensitive(final, "finalUnitAction");
+        if (!cJSON_IsString(action) || strcmp(action->valuestring, "TERMINATE")) goto done;
+    }
+    if (operation == SMF_CHF_UPDATE) goto grant_accepted;
+    location = ogs_sbi_header_get(response->http.headers, OGS_SBI_LOCATION);
+    if (!location) goto done;
+    origin = ogs_msprintf("http://%s:%u", smf_self()->chf_config.addr,
+            smf_self()->chf_config.port);
+    path = location;
+    if (*location != '/') {
+        if (strncmp(location, origin, strlen(origin))) goto done;
+        path = location + strlen(origin);
+    }
+    if (strncmp(path, SMF_CHF_COLLECTION "/", strlen(SMF_CHF_COLLECTION) + 1)) goto done;
+    ref = path + strlen(SMF_CHF_COLLECTION) + 1;
+    /* This CHF's profile uses UUID references. Prevent credential-forwarding/SSRF. */
+    if (strlen(ref) != 36 || ogs_uuid_parse(&uuid, ref) != OGS_OK) goto done;
+    sess->chf->resource_uri = ogs_msprintf("%s%s", origin, path);
+    sess->chf->charging_session_id = ogs_strdup(ref);
+grant_accepted:
+    sess->chf->granted_units = granted;
+    sess->chf->validity_time = validity;
+    sess->chf->final_units = final != NULL;
+    valid = true;
+    ogs_info("Nchf response authorized: operation=%d session=%u grant=%" PRIu64 " final=%d",
+            operation, sess->id, granted, sess->chf->final_units);
+done:
+    if (smf_chf_journal(sess->chf, valid ? "response_valid" : "response_invalid",
+                operation == SMF_CHF_CREATE ? sess->chf->resource_uri :
+                    (transaction && transaction->request ? transaction->request->h.uri : NULL),
+                response ? response->http.content : NULL,
+                response ? response->status : 0) != OGS_OK) {
+        valid = false;
+        sess->chf->closed = false;
+    }
+    if (!valid) {
+        sess->chf->uncertain = true;
+        ogs_warn("Nchf operation=%d failed or invalid response (HTTP %d)",
+                operation, response ? response->status : 0);
+    } else if (transaction && transaction->has_usage) {
+        sess->chf->consumed_units += transaction->used_units;
+        sess->chf->usage_sequence_number = transaction->usage_sequence;
+        sess->chf->has_usage_sequence = true;
+        for (unsigned int i = 0; i < sess->chf->report_count; i++) {
+            if (sess->chf->reports[i].sequence <= transaction->usage_sequence)
+                sess->chf->reports[i].confirmed = true;
+        }
+    }
+    if (origin) ogs_free(origin);
+    if (root) cJSON_Delete(root);
+    return valid;
+}
+
+/* Bridge a PFCP Usage Report to an Nchf_Update.
+ * Called from n4-handler.c when a session has an active CHF context.
+ * Returns true if the update was sent (or the session should terminate). */
+bool smf_chf_handle_usage_report(smf_sess_t *sess,
+        ogs_pfcp_usage_report_trigger_t *rep_trig,
+        uint64_t uplink, uint64_t downlink, uint32_t ur_seqn)
+{
+    const char *trigger;
+    int recorded;
+    if (!sess->chf || !sess->chf->resource_uri || sess->chf->closed) return false;
+    recorded = smf_chf_record_report(sess->chf, ur_seqn, uplink, downlink);
+    if (recorded == OGS_ERROR) return false;
+    if (recorded == 0) return true; /* Exact PFCP retransmission: no second debit. */
+    /* Determine the Nchf trigger from the PFCP reporting trigger. */
+    if (rep_trig->volume_quota)
+        trigger = "QUOTA_EXHAUSTED";
+    else if (rep_trig->volume_threshold)
+        trigger = "QUOTA_THRESHOLD";
+    else if (rep_trig->quota_validity_time)
+        trigger = "VALIDITY_TIME";
+    else {
+        sess->chf->closing = true;
+        return false; /* Unknown trigger retained, never mislabeled as exhaustion. */
+    }
+    /* If we already received TERMINATE, don't request more quota. */
+    sess->chf->reports[sess->chf->report_count - 1].trigger = trigger;
+    if (sess->chf->final_units || sess->chf->closing ||
+            sess->chf->report_count >= SMF_CHF_MAX_REPORTS - 1) {
+        /* Keep ALL deltas for Release, wait for an in-flight Update first. */
+        sess->chf->closing = true;
+        ogs_info("CHF report retained for terminal accounting session=%u", sess->id);
+        return true; /* Signal caller to initiate session release. */
+    }
+    if (sess->chf->pending) {
+        ogs_info("CHF usage queued behind pending Update session=%u sequence=%u",
+                sess->id, ur_seqn);
+        return true;
+    }
+    if (smf_chf_flush_update(sess) != OGS_OK) {
+        ogs_warn("CHF Update send failed for session=%u; marking uncertain", sess->id);
+        return false;
+    }
+    return true;
+}
+
+/* OGS_OK: one Update submitted; OGS_DONE: no queued usage; OGS_ERROR: fail closed. */
+int smf_chf_flush_update(smf_sess_t *sess)
+{
+    smf_chf_usage_t usage;
+    int rv = smf_chf_next_usage(sess->chf, &usage);
+    if (rv != OGS_OK) return rv;
+    return smf_chf_send_change(sess, SMF_CHF_UPDATE, &usage);
+}
+
+/* Send Nchf_Release with final usage extracted from Session Deletion Response.
+ * Sets release_pending so the session context is retained until 204 arrives. */
+int smf_chf_send_final_release(smf_sess_t *sess,
+        uint64_t uplink, uint64_t downlink, uint32_t sequence)
+{
+    if (!sess->chf || !sess->chf->resource_uri || sess->chf->closed)
+        return OGS_ERROR;
+    sess->chf->closing = true;
+    if (smf_chf_record_report(sess->chf, sequence, uplink, downlink) == OGS_ERROR)
+        return OGS_ERROR;
+    if (sess->chf->release_pending) return OGS_OK;
+    sess->chf->release_request = smf_chf_build_change(sess, SMF_CHF_RELEASE, NULL);
+    if (!sess->chf->release_request) return OGS_ERROR;
+    sess->chf->release_pending = true;
+    if (smf_chf_journal(sess->chf, "release_queued", sess->chf->release_request->h.uri,
+                sess->chf->release_request->http.content, 0) != OGS_OK) return OGS_ERROR;
+    return smf_chf_flush_release(sess->chf, sess->id);
+}
+
+int smf_chf_flush_release(smf_chf_sess_t *chf, ogs_pool_id_t sess_id)
+{
+    smf_chf_transaction_t *transaction;
+    if (!chf->release_request || chf->pending) return OGS_OK;
+    if (chf->uncertain || chf->closed) return OGS_ERROR;
+    transaction = ogs_calloc(1, sizeof(*transaction));
+    ogs_assert(transaction);
+    transaction->operation = SMF_CHF_RELEASE;
+    transaction->sess_id = sess_id;
+    transaction->generation = chf->generation;
+    transaction->owner = chf;
+    chf->refs++;
+    transaction->request = chf->release_request;
+    chf->release_request = NULL;
+    if (smf_chf_release_body(chf, transaction->request, transaction) != OGS_OK) goto failed;
+    chf->sequence_number++;
+    if (smf_chf_journal(chf, "request", transaction->request->h.uri,
+                transaction->request->http.content, 0) != OGS_OK ||
+            !ogs_sbi_client_send_request(chf_client, client_callback,
+                transaction->request, transaction)) goto failed;
+    chf->pending = true;
+    return OGS_OK;
+failed:
+    chf->uncertain = true;
+    smf_chf_transaction_free(transaction);
+    return OGS_ERROR;
+}
+
+/* Called ONLY from wait_chf_create before any PFCP establishment is sent.
+ * A zero grant still created an Nchf resource; close it without inventing URR
+ * evidence or leaving a permanently OPEN, zero-credit accounting context. */
+int smf_chf_cancel_before_pfcp(smf_sess_t *sess)
+{
+    smf_chf_sess_t *chf = sess->chf;
+    if (!chf || !chf->resource_uri || chf->uncertain || chf->pending ||
+            chf->report_count || chf->closed || chf->release_pending) return OGS_ERROR;
+    chf->closing = true;
+    if (smf_chf_journal(chf, "no_user_plane", NULL, NULL, 0) != OGS_OK) return OGS_ERROR;
+    chf->release_request = smf_chf_build_change(sess, SMF_CHF_RELEASE, NULL);
+    if (!chf->release_request) return OGS_ERROR;
+    chf->release_pending = true;
+    if (smf_chf_journal(chf, "release_queued", chf->release_request->h.uri,
+                chf->release_request->http.content, 0) != OGS_OK) return OGS_ERROR;
+    return smf_chf_flush_release(chf, sess->id);
+}
diff --git a/src/smf/chf-path.h b/src/smf/chf-path.h
new file mode 100644
index 0000000..feb40d6
--- /dev/null
+++ b/src/smf/chf-path.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * MAEstro experimental TS 32.291 Rel16 volume-charging profile.
+ */
+#ifndef SMF_CHF_PATH_H
+#define SMF_CHF_PATH_H
+#include "context.h"
+
+void smf_chf_config_init(ogs_chf_config_t *config);
+int smf_chf_config_parse(ogs_yaml_iter_t *iter);
+int smf_chf_config_validate(ogs_chf_config_t *config);
+
+#define SMF_CHF_COLLECTION "/nchf-convergedcharging/v3/chargingdata"
+typedef enum { SMF_CHF_CREATE = 1, SMF_CHF_UPDATE, SMF_CHF_RELEASE } smf_chf_operation_e;
+typedef struct smf_chf_usage_s {
+    uint32_t sequence;
+    uint64_t uplink;
+    uint64_t downlink;
+    const char *trigger;
+} smf_chf_usage_t;
+typedef struct smf_chf_transaction_s {
+    ogs_pool_id_t sess_id;
+    uint64_t generation;
+    smf_chf_operation_e operation;
+    unsigned int retries;
+    uint64_t used_units;
+    uint32_t usage_sequence;
+    bool has_usage;
+    smf_chf_sess_t *owner;
+    ogs_sbi_request_t *request;
+} smf_chf_transaction_t;
+
+int smf_chf_open(void);
+void smf_chf_sess_clear(smf_sess_t *sess);
+int smf_chf_send_create(smf_sess_t *sess);
+bool smf_chf_urr_supported(smf_sess_t *sess);
+int smf_chf_prepare_initial_urr(smf_sess_t *sess);
+int smf_chf_renew_urr(smf_sess_t *sess);
+ogs_sbi_request_t *smf_chf_build_create(smf_sess_t *sess);
+ogs_sbi_request_t *smf_chf_build_change(smf_sess_t *sess,
+        smf_chf_operation_e operation, const smf_chf_usage_t *usage);
+int smf_chf_send_change(smf_sess_t *sess,
+        smf_chf_operation_e operation, const smf_chf_usage_t *usage);
+int smf_chf_next_usage(smf_chf_sess_t *chf, smf_chf_usage_t *usage);
+int smf_chf_flush_update(smf_sess_t *sess);
+bool smf_chf_handle_response(smf_sess_t *sess, smf_event_t *event);
+void smf_chf_transaction_free(smf_chf_transaction_t *transaction);
+bool smf_chf_handle_usage_report(smf_sess_t *sess,
+        ogs_pfcp_usage_report_trigger_t *rep_trig,
+        uint64_t uplink, uint64_t downlink, uint32_t ur_seqn);
+int smf_chf_send_final_release(smf_sess_t *sess,
+        uint64_t uplink, uint64_t downlink, uint32_t sequence);
+void smf_chf_context_unref(smf_chf_sess_t *chf);
+int smf_chf_record_report(smf_chf_sess_t *chf, uint32_t sequence,
+        uint64_t uplink, uint64_t downlink);
+int smf_chf_release_body(smf_chf_sess_t *chf, ogs_sbi_request_t *request,
+        smf_chf_transaction_t *transaction);
+int smf_chf_flush_release(smf_chf_sess_t *chf, ogs_pool_id_t sess_id);
+int smf_chf_cancel_before_pfcp(smf_sess_t *sess);
+bool smf_chf_release_confirmed(int status, const ogs_sbi_response_t *response);
+int smf_chf_journal_open(smf_chf_sess_t *chf);
+int smf_chf_allocate_id(const char *nf_id, uint32_t *value);
+int smf_chf_journal(smf_chf_sess_t *chf, const char *event,
+        const char *uri, const char *body, int status);
+
+#endif
diff --git a/src/smf/chf-probe.c b/src/smf/chf-probe.c
new file mode 100644
index 0000000..420ee2f
--- /dev/null
+++ b/src/smf/chf-probe.c
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Component integration probe: uses the real SMF context, builder, HTTP/2
+ * client and response handler. Does not start a RAN or establish an N4 session.
+ */
+#include "chf-path.h"
+
+int main(int argc, char *argv[])
+{
+    const char *app_argv[4];
+    ogs_yaml_iter_t root, node;
+    smf_ue_t *ue;
+    smf_sess_t *sess;
+    ogs_time_t deadline;
+    bool complete = false, accepted = false;
+    bool lifecycle, terminal, concurrent;
+    uint64_t last_grant = 0, last_consumed = 0;
+    bool last_closed = false;
+    int result = 1, stage = 0;
+    if (argc != 3) {
+        fprintf(stderr, "Usage: chf-probe CONFIG success|failure|disabled|lifecycle|final-usage|concurrent-close\n");
+        return 2;
+    }
+    lifecycle = !strcmp(argv[2], "lifecycle");
+    concurrent = !strcmp(argv[2], "concurrent-close");
+    terminal = concurrent || !strcmp(argv[2], "final-usage");
+    app_argv[0] = argv[0]; app_argv[1] = "-c"; app_argv[2] = argv[1]; app_argv[3] = NULL;
+    if (ogs_app_initialize(NULL, NULL, app_argv) != OGS_OK) return 2;
+    if (ogs_app_parse_local_conf("smf") != OGS_OK) return 2;
+    smf_metrics_init();
+    ogs_gtp_context_init(ogs_app()->pool.nf * OGS_MAX_NUM_OF_GTPU_RESOURCE);
+    ogs_pfcp_context_init();
+    ogs_sbi_context_init(OpenAPI_nf_type_SMF);
+    smf_context_init();
+    if (ogs_sbi_context_parse_config("smf", "nrf", "scp") != OGS_OK) return 2;
+    ogs_yaml_iter_init(&root, ogs_app()->document);
+    while (ogs_yaml_iter_next(&root)) {
+        if (strcmp(ogs_yaml_iter_key(&root), "smf")) continue;
+        ogs_yaml_iter_recurse(&root, &node);
+        while (ogs_yaml_iter_next(&node)) {
+            if (!strcmp(ogs_yaml_iter_key(&node), "chf") &&
+                    smf_chf_config_parse(&node) != OGS_OK) return 2;
+        }
+    }
+    if (smf_chf_config_validate(&smf_self()->chf_config) != OGS_OK ||
+            smf_chf_open() != OGS_OK) return 2;
+    if (!strcmp(argv[2], "disabled")) {
+        result = smf_self()->chf_config.enabled ? 1 : 0;
+        printf("CHF disabled: %s\n", result ? "FAIL" : "PASS");
+        goto done;
+    }
+    ue = smf_ue_add_by_supi((char *)"imsi-001010000000001");
+    ogs_assert(ue);
+    sess = smf_sess_add_by_psi(ue, 1);
+    ogs_assert(sess);
+    sess->session.name = ogs_strdup("internet");
+    sess->s_nssai.sst = 1;
+    if (smf_chf_send_create(sess) != OGS_OK) goto done;
+    deadline = ogs_get_monotonic_time() + ogs_time_from_sec(30);
+    while (!complete && ogs_get_monotonic_time() < deadline) {
+        smf_event_t *event = NULL;
+        ogs_pollset_poll(ogs_app()->pollset, ogs_time_from_msec(50));
+        ogs_timer_mgr_expire(ogs_app()->timer_mgr);
+        while (ogs_queue_trypop(ogs_app()->queue, (void **)&event) == OGS_OK) {
+            if (event->h.id == SMF_EVT_CHF_RESPONSE) {
+                smf_chf_transaction_t *transaction = event->h.sbi.data;
+                smf_chf_sess_t *owner = transaction->owner;
+                smf_sess_t shadow = {0};
+                smf_chf_operation_e operation = transaction->operation;
+                shadow.chf = owner;
+                owner->pending = false; /* Same ownership as smf-sm.c. */
+                /* Match the FSM: a valid zero-grant response cannot authorize N4. */
+                accepted = smf_chf_handle_response(&shadow, event) &&
+                    (operation == SMF_CHF_RELEASE || owner->granted_units > 0);
+                last_grant = owner->granted_units;
+                last_consumed = owner->consumed_units;
+                last_closed = owner->closed;
+                printf("NCHF_OPERATION=%d\n", transaction->operation);
+                printf("NCHF_REQUEST_JSON=%s\n", transaction->request->http.content);
+                printf("NCHF_RETRIES=%u\n", transaction->retries);
+                printf("NCHF_GRANT=%" PRIu64 "\n", owner->granted_units);
+                printf("NCHF_FINAL=%d\n", owner->final_units);
+                if (event->h.sbi.response) {
+                    if (event->h.sbi.response->http.content_length)
+                        printf("NCHF_RESPONSE_JSON=%s\n", event->h.sbi.response->http.content);
+                    printf("NCHF_HTTP_STATUS=%d\n", event->h.sbi.response->status);
+                    ogs_sbi_response_free(event->h.sbi.response);
+                }
+                complete = true;
+                if (terminal && accepted && operation == SMF_CHF_CREATE) {
+                    ogs_pfcp_usage_report_trigger_t report_trigger = {0};
+                    if (concurrent) {
+                        report_trigger.volume_threshold = 1;
+                        ogs_assert(smf_chf_handle_usage_report(sess, &report_trigger, 4112, 4112, 0));
+                        report_trigger.volume_threshold = 0;
+                        report_trigger.volume_quota = 1;
+                        ogs_assert(smf_chf_handle_usage_report(sess, &report_trigger, 1028, 1028, 1));
+                        ogs_assert(smf_chf_send_final_release(sess, 0, 0, 2) == OGS_OK);
+                    } else {
+                        ogs_assert(owner->final_units);
+                        report_trigger.volume_quota = 1;
+                        ogs_assert(smf_chf_handle_usage_report(sess, &report_trigger, 5140, 5140, 0));
+                        ogs_assert(smf_chf_send_final_release(sess, 0, 0, 1) == OGS_OK);
+                    }
+                    smf_chf_sess_clear(sess); /* Release/Update outlive network ownership. */
+                    printf("NCHF_NETWORK_OWNER_DETACHED=1\n");
+                    complete = false;
+                } else if (terminal && accepted && operation == SMF_CHF_UPDATE) {
+                    ogs_assert(smf_chf_flush_release(owner, sess->id) == OGS_OK);
+                    complete = false;
+                }
+                smf_chf_transaction_free(transaction);
+                if (lifecycle && accepted && stage < 2) {
+                    /* Explicit protocol-test fixtures, NOT PFCP/UE measurements. */
+                    smf_chf_usage_t usage = {0};
+                    if (stage == 1) {
+                        smf_chf_usage_t duplicate = {0};
+                        duplicate.uplink = 100;
+                        duplicate.downlink = 200;
+                        duplicate.trigger = "QUOTA_THRESHOLD";
+                        ogs_assert(smf_chf_send_change(sess, SMF_CHF_UPDATE, &duplicate) == OGS_ERROR);
+                        printf("NCHF_DUPLICATE_LOCAL=REJECTED\n");
+                    }
+                    usage.sequence = stage;
+                    usage.uplink = stage == 0 ? 100 : 50;
+                    usage.downlink = stage == 0 ? 200 : 50;
+                    usage.trigger = stage == 0 ? "QUOTA_THRESHOLD" : "FINAL";
+                    if (smf_chf_send_change(sess, stage == 0 ? SMF_CHF_UPDATE : SMF_CHF_RELEASE,
+                                &usage) != OGS_OK) accepted = false;
+                    else { stage++; complete = false; }
+                }
+            }
+            ogs_event_free(event);
+        }
+    }
+    result = complete && (accepted == (!strcmp(argv[2], "success") || lifecycle || terminal)) ? 0 : 1;
+    if (lifecycle && (!last_closed || last_consumed != 400)) result = 1;
+    if (terminal && (!last_closed || last_consumed != 10280)) result = 1;
+    printf("Native Nchf component: %s (accepted=%d, grant=%" PRIu64 ")\n",
+            result ? "FAIL" : "PASS", accepted, last_grant);
+done:
+    ogs_sbi_client_stop_all();
+    smf_context_final();
+    ogs_sbi_context_final();
+    ogs_pfcp_context_final();
+    ogs_gtp_context_final();
+    smf_metrics_final();
+    ogs_app_terminate();
+    return result;
+}
diff --git a/src/smf/chf-unit.c b/src/smf/chf-unit.c
new file mode 100644
index 0000000..c18fff1
--- /dev/null
+++ b/src/smf/chf-unit.c
@@ -0,0 +1,355 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Native parser/response unit tests; these are NOT an end-to-end demonstration.
+ */
+#include "chf-path.h"
+#include <unistd.h>
+#include <sys/stat.h>
+
+static int checks;
+#define CHECK(condition) do { \
+    checks++; \
+    if (!(condition)) { fprintf(stderr, "FAILED line %d: %s\n", __LINE__, #condition); exit(1); } \
+} while (0)
+
+static void config_case(const char *yaml, bool valid, bool enabled)
+{
+    yaml_parser_t parser;
+    yaml_document_t document;
+    ogs_yaml_iter_t iter;
+    int result;
+    CHECK(yaml_parser_initialize(&parser));
+    yaml_parser_set_input_string(&parser, (const unsigned char *)yaml, strlen(yaml));
+    CHECK(yaml_parser_load(&parser, &document));
+    smf_chf_config_init(&smf_self()->chf_config);
+    ogs_yaml_iter_init(&iter, &document);
+    CHECK(ogs_yaml_iter_next(&iter));
+    result = smf_chf_config_parse(&iter);
+    if (result == OGS_OK) result = smf_chf_config_validate(&smf_self()->chf_config);
+    CHECK((result == OGS_OK) == valid);
+    if (valid) CHECK(smf_self()->chf_config.enabled == enabled);
+    yaml_document_delete(&document);
+    yaml_parser_delete(&parser);
+}
+
+static void response_case(const char *body, const char *location,
+        int status, bool valid, uint64_t granted, bool final_units)
+{
+    smf_sess_t sess;
+    smf_event_t event;
+    ogs_sbi_response_t *response = ogs_sbi_response_new();
+    memset(&sess, 0, sizeof(sess));
+    memset(&event, 0, sizeof(event));
+    sess.chf = ogs_calloc(1, sizeof(*sess.chf));
+    sess.chf->sequence_number = 1;
+    sess.chf->rating_group = 1;
+    response->status = status;
+    response->http.content = ogs_strdup(body);
+    response->http.content_length = strlen(body);
+    if (location) ogs_sbi_header_set(response->http.headers, OGS_SBI_LOCATION, location);
+    event.h.sbi.state = OGS_OK;
+    event.h.sbi.response = response;
+    CHECK(smf_chf_handle_response(&sess, &event) == valid);
+    if (valid) {
+        CHECK(sess.chf->granted_units == granted);
+        CHECK(sess.chf->final_units == final_units);
+    } else CHECK(sess.chf->resource_uri == NULL);
+    sess.chf->closed = true;
+    smf_chf_sess_clear(&sess);
+    ogs_sbi_response_free(response);
+}
+
+#define BODY_PREFIX "{\"invocationSequenceNumber\":1,\"multipleUnitInformation\":[{\"ratingGroup\":1,\"resultCode\":\"SUCCESS\",\"validityTime\":60,\"grantedUnit\":{\"totalVolume\":"
+#define BODY_SUFFIX "}}]}"
+#define LOCATION SMF_CHF_COLLECTION "/00000000-0000-4000-8000-000000000001"
+
+static void change_response_case(smf_chf_operation_e operation,
+        int status, const char *body, bool valid)
+{
+    smf_sess_t sess = {0};
+    smf_event_t event = {0};
+    smf_chf_transaction_t transaction = {0};
+    ogs_sbi_response_t *response = ogs_sbi_response_new();
+    sess.chf = ogs_calloc(1, sizeof(*sess.chf));
+    sess.chf->sequence_number = 1;
+    sess.chf->rating_group = 1;
+    sess.chf->resource_uri = ogs_strdup("http://127.0.0.1:8081" LOCATION);
+    transaction.operation = operation;
+    transaction.used_units = 10;
+    transaction.has_usage = true;
+    transaction.usage_sequence = 0;
+    response->status = status;
+    response->http.content = ogs_strdup(body);
+    response->http.content_length = strlen(body);
+    event.h.sbi.state = OGS_OK;
+    event.h.sbi.response = response;
+    event.h.sbi.data = &transaction;
+    CHECK(smf_chf_handle_response(&sess, &event) == valid);
+    CHECK(sess.chf->consumed_units == (valid ? 10 : 0));
+    CHECK(sess.chf->uncertain == !valid);
+    CHECK(sess.chf->closed == (valid && operation == SMF_CHF_RELEASE));
+    CHECK(sess.chf->has_usage_sequence == valid);
+    sess.chf->closed = true;
+    smf_chf_sess_clear(&sess);
+    ogs_sbi_response_free(response);
+}
+
+static void urr_cases(void)
+{
+    smf_sess_t sess = {0};
+    smf_chf_sess_t chf = {0};
+    smf_bearer_t bearer = {0}, extra = {0};
+    ogs_pfcp_node_t node = {0};
+    ogs_pfcp_urr_t urr = {0};
+    ogs_pfcp_pdr_t ul = {0}, dl = {0};
+    ogs_pfcp_tlv_create_urr_t encoded = {0};
+    ogs_pfcp_volume_quota_t decoded = {0};
+    sess.chf = &chf;
+    sess.pfcp_node = &node;
+    node.up_function_features.vtime = 1;
+    bearer.urr = &urr;
+    bearer.ul_pdr = &ul;
+    bearer.dl_pdr = &dl;
+    urr.id = 7;
+    ogs_list_add(&sess.bearer_list, &bearer);
+    ogs_pfcp_pdr_associate_urr(&dl, &urr); /* Existing default DL association */
+    chf.granted_units = 1048576;
+    chf.validity_time = 300;
+    smf_self()->chf_config.enabled = false;
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_OK);
+    CHECK(urr.vol_quota.total_volume == 0 && ul.num_of_urr == 0);
+    smf_self()->chf_config.enabled = true;
+    CHECK(smf_chf_urr_supported(&sess));
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_OK);
+    CHECK(urr.id == 7);
+    CHECK(urr.meas_method == OGS_PFCP_MEASUREMENT_METHOD_VOLUME);
+    CHECK(urr.vol_quota.tovol && urr.vol_quota.total_volume == 1048576);
+    CHECK(urr.vol_threshold.total_volume == 838860);
+    CHECK(urr.rep_triggers.volume_threshold && urr.rep_triggers.volume_quota);
+    CHECK(urr.rep_triggers.quota_validity_time && urr.quota_validity_time == 300);
+    CHECK(ul.num_of_urr == 1 && dl.num_of_urr == 1);
+    CHECK(ul.urr[0] == &urr && dl.urr[0] == &urr);
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_OK);
+    CHECK(ul.num_of_urr == 1 && dl.num_of_urr == 1);
+    /* Exercise upstream's real PFCP IE encoder and volume decoder. */
+    ogs_pfcp_build_create_urr(&encoded, 0, &urr);
+    CHECK(encoded.presence && encoded.urr_id.u32 == 7);
+    CHECK(encoded.volume_quota.presence && encoded.volume_threshold.presence);
+    CHECK(ogs_pfcp_parse_volume(&decoded, &encoded.volume_quota) > 0);
+    CHECK(decoded.tovol && decoded.total_volume == 1048576);
+    CHECK(ogs_pfcp_parse_volume(&decoded, &encoded.volume_threshold) > 0);
+    CHECK(decoded.total_volume == 838860);
+    CHECK(encoded.quota_validity_time.presence && encoded.quota_validity_time.u32 == 300);
+    chf.final_units = true;
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_OK);
+    CHECK(!urr.rep_triggers.volume_threshold && !urr.vol_threshold.flags);
+    CHECK(urr.vol_quota.total_volume == 1048576 && urr.rep_triggers.volume_quota);
+    chf.final_units = false;
+    chf.granted_units = 1;
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_OK);
+    CHECK(!urr.rep_triggers.volume_threshold && urr.vol_quota.total_volume == 1);
+    chf.granted_units = UINT32_MAX;
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_OK);
+    CHECK(urr.vol_threshold.total_volume == 3435973836ULL);
+    chf.granted_units = (uint64_t)UINT32_MAX + 1;
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_ERROR);
+    chf.granted_units = 0;
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_ERROR);
+    chf.granted_units = 10;
+    chf.validity_time = 0;
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_ERROR);
+    chf.validity_time = 60;
+    node.up_function_features.vtime = 0;
+    CHECK(!smf_chf_urr_supported(&sess));
+    CHECK(smf_chf_prepare_initial_urr(&sess) == OGS_ERROR);
+    node.up_function_features.vtime = 1;
+    ogs_list_add(&sess.bearer_list, &extra);
+    CHECK(!smf_chf_urr_supported(&sess));
+    ogs_list_remove(&sess.bearer_list, &extra);
+    sess.epc = true;
+    CHECK(!smf_chf_urr_supported(&sess));
+    smf_self()->chf_config.enabled = false;
+}
+
+static void accounting_cases(void)
+{
+    {
+        smf_chf_sess_t window = {0};
+        smf_chf_usage_t next;
+        for (uint32_t sequence = 0; sequence < 10000; sequence++) {
+            CHECK(smf_chf_record_report(&window, sequence, 10, 20) == 1);
+            CHECK(window.report_count < SMF_CHF_MAX_REPORTS - 1);
+            window.reports[window.report_count - 1].trigger = "QUOTA_THRESHOLD";
+            CHECK(smf_chf_next_usage(&window, &next) == OGS_OK);
+            CHECK(next.sequence == sequence && next.uplink + next.downlink == 30);
+            window.reports[window.report_count - 1].confirmed = true;
+            CHECK(smf_chf_record_report(&window, sequence, 10, 20) == 0);
+        }
+        CHECK(!window.uncertain && !window.closing);
+        CHECK(smf_chf_record_report(&window, 10000, 5, 6) == 1);
+        CHECK(!window.reports[window.report_count - 1].confirmed);
+        /* Never silently accept a stale delta outside the retained window. */
+        CHECK(smf_chf_record_report(&window, 0, 10, 20) == OGS_ERROR);
+        CHECK(window.uncertain);
+    }
+    smf_chf_sess_t chf = {0}, conflict = {0}, gap = {0};
+    smf_chf_transaction_t tx = {0};
+    ogs_sbi_request_t *request = ogs_sbi_request_new();
+    ogs_sbi_response_t *response = ogs_sbi_response_new();
+    cJSON *root, *used;
+    CHECK(smf_chf_record_report(&chf, 0, 4112, 4112) == 1);
+    CHECK(smf_chf_record_report(&chf, 0, 4112, 4112) == 0);
+    CHECK(chf.report_count == 1);
+    {
+        smf_chf_usage_t next;
+        chf.reports[0].trigger = "QUOTA_THRESHOLD";
+        chf.pending = true;
+        CHECK(smf_chf_next_usage(&chf, &next) == OGS_DONE);
+        CHECK(!chf.closing);
+        chf.pending = false;
+        CHECK(smf_chf_next_usage(&chf, &next) == OGS_OK);
+        CHECK(next.sequence == 0 && next.uplink == 4112 && next.downlink == 4112);
+        CHECK(!strcmp(next.trigger, "QUOTA_THRESHOLD"));
+    }
+    chf.reports[0].confirmed = true;
+    chf.consumed_units = 8224;
+    chf.sequence_number = 2;
+    CHECK(smf_chf_record_report(&chf, 1, 1028, 1028) == 1);
+    CHECK(smf_chf_record_report(&chf, 2, 0, 0) == 1);
+    {
+        smf_chf_usage_t next;
+        chf.reports[1].trigger = "QUOTA_EXHAUSTED";
+        chf.reports[2].trigger = "VALIDITY_TIME";
+        CHECK(smf_chf_next_usage(&chf, &next) == OGS_OK);
+        CHECK(next.sequence == 1 && next.uplink == 1028);
+        chf.reports[1].confirmed = true;
+        CHECK(smf_chf_next_usage(&chf, &next) == OGS_OK);
+        CHECK(next.sequence == 2 && !strcmp(next.trigger, "VALIDITY_TIME"));
+        chf.reports[1].confirmed = false;
+    }
+    request->http.content = ogs_strdup("{\"invocationSequenceNumber\":2,\"invocationTimeStamp\":\"old\",\"multipleUnitUsage\":[{\"ratingGroup\":1}]}");
+    CHECK(smf_chf_release_body(&chf, request, &tx) == OGS_OK);
+    CHECK(tx.used_units == 2056 && tx.usage_sequence == 2 && tx.has_usage);
+    root = cJSON_Parse(request->http.content);
+    CHECK(cJSON_GetObjectItemCaseSensitive(root, "invocationSequenceNumber")->valueint == 3);
+    used = cJSON_GetObjectItemCaseSensitive(cJSON_GetArrayItem(cJSON_GetObjectItemCaseSensitive(root, "multipleUnitUsage"), 0), "usedUnitContainer");
+    CHECK(cJSON_GetArraySize(used) == 2);
+    CHECK(cJSON_GetObjectItemCaseSensitive(cJSON_GetArrayItem(used, 0), "localSequenceNumber")->valueint == 1);
+    CHECK(cJSON_GetObjectItemCaseSensitive(cJSON_GetArrayItem(used, 0), "totalVolume")->valueint == 2056);
+    CHECK(cJSON_GetObjectItemCaseSensitive(cJSON_GetArrayItem(used, 1), "localSequenceNumber")->valueint == 2);
+    CHECK(cJSON_GetObjectItemCaseSensitive(cJSON_GetArrayItem(used, 1), "totalVolume")->valueint == 0);
+    cJSON_Delete(root);
+    ogs_sbi_request_free(request);
+    CHECK(smf_chf_record_report(&conflict, 0, 1, 2) == 1);
+    CHECK(smf_chf_record_report(&conflict, 0, 2, 2) == OGS_ERROR);
+    CHECK(conflict.uncertain && conflict.closing && conflict.report_count == 1);
+    CHECK(smf_chf_record_report(&gap, 1, 1, 2) == OGS_ERROR);
+    CHECK(gap.uncertain && gap.report_count == 0);
+    response->status = 204;
+    CHECK(smf_chf_release_confirmed(OGS_OK, response));
+    CHECK(!smf_chf_release_confirmed(OGS_TIMEUP, response));
+    CHECK(!smf_chf_release_confirmed(OGS_OK, NULL));
+    response->http.content_length = 2;
+    CHECK(!smf_chf_release_confirmed(OGS_OK, response));
+    response->http.content_length = 0;
+    response->status = 503;
+    CHECK(!smf_chf_release_confirmed(OGS_OK, response));
+    ogs_sbi_response_free(response);
+    /* Detaching the network session must not free accounting owned by HTTP. */
+    {
+        smf_sess_t sess = {0};
+        smf_chf_transaction_t *pending = ogs_calloc(1, sizeof(*pending));
+        sess.chf = ogs_calloc(1, sizeof(*sess.chf));
+        sess.chf->refs = 2;
+        pending->owner = sess.chf;
+        pending->owner->consumed_units = 8224;
+        smf_chf_sess_clear(&sess);
+        CHECK(sess.chf == NULL && pending->owner->refs == 1);
+        CHECK(pending->owner->consumed_units == 8224);
+        pending->owner->closed = true;
+        smf_chf_transaction_free(pending);
+    }
+    /* Durable journal records original evidence and fails closed on disk errors. */
+    {
+        char directory[] = "/tmp/maestro-chf-unit-XXXXXX";
+        smf_chf_sess_t *durable = ogs_calloc(1, sizeof(*durable));
+        struct stat st;
+        FILE *file;
+        char line[1024];
+        CHECK(mkdtemp(directory) != NULL);
+        smf_self()->chf_config.journal_dir = directory;
+        {
+            uint32_t id = 0;
+            const char *nf = "00100000-0000-4000-8000-000000000001";
+            char *counter = ogs_msprintf("%s/charging-id-%s", directory, nf);
+            CHECK(smf_chf_allocate_id(nf, &id) == OGS_OK && id == 1);
+            CHECK(smf_chf_allocate_id(nf, &id) == OGS_OK && id == 2);
+            CHECK(smf_chf_allocate_id("../escape", &id) == OGS_ERROR);
+            file = fopen(counter, "a");
+            CHECK(file != NULL);
+            CHECK(fputs("x", file) >= 0);
+            fclose(file);
+            CHECK(smf_chf_allocate_id(nf, &id) == OGS_ERROR && id == 2);
+            ogs_free(counter);
+        }
+        CHECK(smf_chf_journal_open(durable) == OGS_OK);
+        CHECK(stat(durable->journal_path, &st) == 0 && (st.st_mode & 0077) == 0);
+        CHECK(smf_chf_record_report(durable, 0, 123, 456) == 1);
+        file = fopen(durable->journal_path, "r");
+        CHECK(file != NULL);
+        CHECK(fgets(line, sizeof(line), file) != NULL);
+        CHECK(strstr(line, "pfcp_usage") != NULL && strstr(line, "123") != NULL);
+        fclose(file);
+        close(durable->journal_fd);
+        durable->journal_fd = -1;
+        CHECK(smf_chf_record_report(durable, 1, 5, 6) == OGS_ERROR);
+        CHECK(durable->uncertain && durable->report_count == 1);
+        smf_chf_context_unref(durable);
+        smf_self()->chf_config.journal_dir = "./chf-journal";
+    }
+}
+
+int main(void)
+{
+    ogs_core_initialize();
+    ogs_log_install_domain(&__smf_log_domain, "smf", OGS_LOG_ERROR);
+    ogs_sbi_message_init(32, 32);
+    config_case("chf: {enabled: false, sbi: malformed, unknown: ignored}", true, false);
+    config_case("chf: {enabled: TRUE}", false, false);
+    config_case("chf: {enabled: true, enabled: false}", false, false);
+    config_case("chf: {}", false, false);
+    config_case("chf: {enabled: true, lab_no_auth: true, sbi: [{addr: 127.0.0.1, port: 8081}]}", true, true);
+    config_case("chf: {enabled: true, lab_no_auth: true, sbi: [{addr: invalid}]}", false, false);
+    config_case("chf: {enabled: true, lab_no_auth: true, sbi: [{addr: 127.0.0.1, port: 65536}]}", false, false);
+    config_case("chf: {enabled: true, lab_no_auth: true, sbi: [{addr: 127.0.0.1}], retries: -1}", false, false);
+    config_case("chf: {enabled: true, lab_no_auth: true, sbi: [{addr: 127.0.0.1}], timeout_ms: 0}", false, false);
+    config_case("chf: {enabled: true, lab_no_auth: true, sbi: [{addr: 127.0.0.1}, {addr: 127.0.0.2}]}", false, false);
+    config_case("chf: {enabled: true, lab_no_auth: true, sbi: [{addr: 127.0.0.1}], typo: 1}", false, false);
+    config_case("chf: {enabled: true, sbi: [{addr: 127.0.0.1}], token_env: MAESTRO_TEST_ABSENT_TOKEN}", false, false);
+    smf_chf_config_init(&smf_self()->chf_config);
+    smf_self()->chf_config.addr = "127.0.0.1";
+    response_case(BODY_PREFIX "1048576" BODY_SUFFIX, LOCATION, 201, true, 1048576, false);
+    response_case(BODY_PREFIX "10},\"finalUnitIndication\":{\"finalUnitAction\":\"TERMINATE\"}}]}", LOCATION, 201, true, 10, true);
+    response_case(BODY_PREFIX "0" BODY_SUFFIX, LOCATION, 201, true, 0, false);
+    response_case(BODY_PREFIX "1.5" BODY_SUFFIX, LOCATION, 201, false, 0, false);
+    response_case(BODY_PREFIX "-1" BODY_SUFFIX, LOCATION, 201, false, 0, false);
+    response_case(BODY_PREFIX "1e999" BODY_SUFFIX, LOCATION, 201, false, 0, false);
+    response_case(BODY_PREFIX "1048577" BODY_SUFFIX, LOCATION, 201, false, 0, false);
+    response_case(BODY_PREFIX "100" BODY_SUFFIX, "http://evil.invalid" LOCATION, 201, false, 0, false);
+    response_case(BODY_PREFIX "100" BODY_SUFFIX, "http://127.0.0.1:8081.evil.invalid" LOCATION, 201, false, 0, false);
+    response_case(BODY_PREFIX "100" BODY_SUFFIX, LOCATION "/../admin", 201, false, 0, false);
+    response_case(BODY_PREFIX "100" BODY_SUFFIX, NULL, 201, false, 0, false);
+    response_case(BODY_PREFIX "100" BODY_SUFFIX, LOCATION, 200, false, 0, false);
+    response_case("{}", LOCATION, 201, false, 0, false);
+    change_response_case(SMF_CHF_UPDATE, 200, BODY_PREFIX "100" BODY_SUFFIX, true);
+    change_response_case(SMF_CHF_UPDATE, 201, BODY_PREFIX "100" BODY_SUFFIX, false);
+    change_response_case(SMF_CHF_UPDATE, 200, "{}", false);
+    change_response_case(SMF_CHF_RELEASE, 204, "", true);
+    change_response_case(SMF_CHF_RELEASE, 200, "", false);
+    change_response_case(SMF_CHF_RELEASE, 204, "{}", false);
+    urr_cases();
+    accounting_cases();
+    ogs_sbi_message_final();
+    ogs_core_terminate();
+    printf("Native CHF checks passed: %d\n", checks);
+    return 0;
+}
diff --git a/src/smf/chf-urr.c b/src/smf/chf-urr.c
new file mode 100644
index 0000000..579dee1
--- /dev/null
+++ b/src/smf/chf-urr.c
