+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * TS 29.244 V16.10.0, 5.2.2.2.1 / 5.2.2.3.1.
+ * One rating group, one default QoS flow, one UPF per PDU session.
+ * Rule construction only; the UPF must separately enforce the quota.
+ */
+#include "chf-path.h"
+
+bool smf_chf_urr_supported(smf_sess_t *sess)
+{
+    smf_bearer_t *bearer;
+    if (!sess || sess->epc || !sess->pfcp_node ||
+            !sess->pfcp_node->up_function_features.vtime ||
+            ogs_list_count(&sess->bearer_list) != 1) return false;
+    bearer = smf_default_bearer_in_sess(sess);
+    /* Do not silently authorize extra QoS flows outside this charging profile. */
+    return bearer && bearer->urr && bearer->ul_pdr && bearer->dl_pdr &&
+        bearer->ul_pdr->num_of_urr < OGS_MAX_NUM_OF_URR &&
+        bearer->dl_pdr->num_of_urr < OGS_MAX_NUM_OF_URR;
+}
+
+int smf_chf_prepare_initial_urr(smf_sess_t *sess)
+{
+    smf_bearer_t *bearer;
+    ogs_pfcp_urr_t *urr;
+    uint64_t grant, threshold;
+    if (!smf_self()->chf_config.enabled) return OGS_OK;
+    if (!smf_chf_urr_supported(sess) || !sess->chf ||
+            !sess->chf->granted_units || !sess->chf->validity_time ||
+            sess->chf->granted_units > UINT32_MAX) return OGS_ERROR;
+    bearer = smf_default_bearer_in_sess(sess);
+    urr = bearer->urr;
+    grant = sess->chf->granted_units;
+    threshold = grant * 4 / 5;
+    /* Preserve the allocator's URR ID, not a hard-coded ID shared by sessions. */
+    urr->meas_method = OGS_PFCP_MEASUREMENT_METHOD_VOLUME;
+    memset(&urr->rep_triggers, 0, sizeof(urr->rep_triggers));
+    memset(&urr->meas_info, 0, sizeof(urr->meas_info));
+    memset(&urr->vol_threshold, 0, sizeof(urr->vol_threshold));
+    memset(&urr->vol_quota, 0, sizeof(urr->vol_quota));
+    urr->meas_period = 0;
+    urr->time_threshold = 0;
+    urr->time_quota = 0;
+    urr->rep_triggers.volume_quota = 1;
+    urr->vol_quota.tovol = 1;
+    urr->vol_quota.total_volume = grant;
+    /* A positive final grant remains usable. No early renewal for final units. */
+    if (threshold && !sess->chf->final_units) {
+        urr->rep_triggers.volume_threshold = 1;
+        urr->vol_threshold.tovol = 1;
+        urr->vol_threshold.total_volume = threshold;
+    }
+    urr->rep_triggers.quota_validity_time = 1;
+    urr->quota_validity_time = sess->chf->validity_time;
+    ogs_pfcp_pdr_associate_urr(bearer->ul_pdr, urr);
+    ogs_pfcp_pdr_associate_urr(bearer->dl_pdr, urr);
+    return OGS_OK;
+}
+
+/* Apply quota from a CHF Update response to the existing URR.
+ * Returns the PFCP modify_flags needed for Session Modification, or 0. */
+int smf_chf_renew_urr(smf_sess_t *sess)
+{
+    smf_bearer_t *bearer;
+    ogs_pfcp_urr_t *urr;
+    uint64_t grant, threshold;
+    if (!smf_self()->chf_config.enabled || !sess->chf ||
+            !sess->chf->granted_units || !sess->chf->validity_time ||
+            sess->chf->granted_units > UINT32_MAX) return OGS_ERROR;
+    bearer = smf_default_bearer_in_sess(sess);
+    if (!bearer || !bearer->urr) return OGS_ERROR;
+    urr = bearer->urr;
+    grant = sess->chf->granted_units;
+    threshold = grant * 4 / 5;
+    urr->meas_method = OGS_PFCP_MEASUREMENT_METHOD_VOLUME;
+    memset(&urr->rep_triggers, 0, sizeof(urr->rep_triggers));
+    memset(&urr->vol_threshold, 0, sizeof(urr->vol_threshold));
+    memset(&urr->vol_quota, 0, sizeof(urr->vol_quota));
+    urr->rep_triggers.volume_quota = 1;
+    urr->vol_quota.tovol = 1;
+    urr->vol_quota.total_volume = grant;
+    if (threshold && !sess->chf->final_units) {
+        urr->rep_triggers.volume_threshold = 1;
+        urr->vol_threshold.tovol = 1;
+        urr->vol_threshold.total_volume = threshold;
+    }
+    urr->rep_triggers.quota_validity_time = 1;
+    urr->quota_validity_time = sess->chf->validity_time;
+    ogs_pfcp_pdr_associate_urr(bearer->ul_pdr, urr);
+    ogs_pfcp_pdr_associate_urr(bearer->dl_pdr, urr);
+    return OGS_OK;
+}
