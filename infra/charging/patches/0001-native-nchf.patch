diff --git a/src/upf/quota-unit.c b/src/upf/quota-unit.c
new file mode 100644
index 0000000..0c095e6
--- /dev/null
+++ b/src/upf/quota-unit.c
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Unit harness for real UPF accounting/gate functions. The report transport is
+ * replaced by a sink here; this is NOT a network or UE acceptance test.
+ */
+#include "context.h"
+#include "pfcp-path.h"
+
+static int checks, reports;
+static bool transport_error;
+static ogs_pfcp_user_plane_report_t last;
+#define CHECK(c) do { checks++; if (!(c)) { \
+    fprintf(stderr, "FAILED %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+
+int upf_pfcp_send_session_report_request(upf_sess_t *sess,
+        ogs_pfcp_user_plane_report_t *report)
+{
+    if (transport_error) return OGS_ERROR;
+    last = *report;
+    reports++;
+    return OGS_OK;
+}
+
+static bool packet(upf_sess_t *sess, ogs_pfcp_pdr_t *pdr, size_t bytes, bool ul)
+{
+    int i;
+    if (!upf_quota_allow(sess, pdr, ul)) return false;
+    for (i = 0; i < pdr->num_of_urr; i++)
+        upf_sess_urr_acc_add(sess, pdr->urr[i], bytes, ul);
+    return true;
+}
+
+int main(void)
+{
+    upf_sess_t sess = {0};
+    ogs_pfcp_urr_t urr = {0};
+    ogs_pfcp_pdr_t pdr = {0};
+    ogs_pfcp_far_t far = {0};
+    ogs_pfcp_qer_t qer = {0};
+    ogs_gtp_node_t gnode = {0};
+    upf_sess_urr_acc_t *acc = &sess.urr_acc[0];
+    ogs_time_t deadline;
+    int before;
+    ogs_core_initialize();
+    ogs_log_install_domain(&__upf_log_domain, "upf", OGS_LOG_ERROR);
+    ogs_app()->timer_mgr = ogs_timer_mgr_create(32);
+    urr.id = 1;
+    urr.sess = &sess.pfcp;
+    urr.meas_method = OGS_PFCP_MEASUREMENT_METHOD_VOLUME;
+    urr.vol_quota.tovol = urr.vol_threshold.tovol = 1;
+    urr.vol_quota.total_volume = 1000;
+    urr.vol_threshold.total_volume = 800;
+    urr.rep_triggers.volume_threshold = urr.rep_triggers.volume_quota = 1;
+    urr.rep_triggers.quota_validity_time = 1;
+    urr.quota_validity_time = 60;
+    /* Update URR must decode the same network-order trigger octets as Create.
+     * Otherwise a renewal silently loses VOLTH/VOLQU/QVTI on the real UPF. */
+    {
+        ogs_pfcp_tlv_update_urr_t update = {0};
+        uint8_t cause = OGS_PFCP_CAUSE_REQUEST_ACCEPTED, offending = 0;
+        ogs_list_add(&sess.pfcp.urr_list, &urr);
+        update.presence = update.urr_id.presence = 1;
+        update.urr_id.u32 = urr.id;
+        update.reporting_triggers.presence = 1;
+        update.reporting_triggers.u24 = (urr.rep_triggers.reptri_5 << 16) |
+            (urr.rep_triggers.reptri_6 << 8) | urr.rep_triggers.reptri_7;
+        memset(&urr.rep_triggers, 0, sizeof(urr.rep_triggers));
+        CHECK(ogs_pfcp_handle_update_urr(&sess.pfcp, &update, &cause, &offending) == &urr);
+        CHECK(cause == OGS_PFCP_CAUSE_REQUEST_ACCEPTED);
+        CHECK(urr.rep_triggers.volume_threshold && urr.rep_triggers.volume_quota);
+        CHECK(urr.rep_triggers.quota_validity_time);
+        ogs_list_remove(&sess.pfcp.urr_list, &urr);
+    }
+    pdr.far = &far;
+    pdr.qer = &qer;
+    pdr.urr[0] = &urr;
+    pdr.num_of_urr = 1;
+    far.apply_action = OGS_PFCP_APPLY_ACTION_FORW;
+    far.gnode = &gnode;
+    upf_quota_install(&sess, &urr, true, true);
+    CHECK(!acc->quota.active); /* Default off preserves original behavior. */
+    CHECK(upf_quota_allow(&sess, &pdr, true));
+    upf_self()->charging_enforcement = true;
+    upf_quota_install(&sess, &urr, true, true);
+    CHECK(acc->quota.active && acc->quota.limit == 1000);
+    deadline = acc->quota.deadline;
+    CHECK(deadline > ogs_get_monotonic_time());
+    CHECK(packet(&sess, &pdr, 600, true));
+    CHECK(reports == 0 && acc->total_octets == 600);
+    CHECK(packet(&sess, &pdr, 250, false));
+    CHECK(reports == 1 && last.usage_report[0].seqn == 0);
+    CHECK(last.usage_report[0].vol_measurement.total_volume == 850);
+    CHECK(last.usage_report[0].vol_measurement.uplink_volume == 600);
+    CHECK(last.usage_report[0].vol_measurement.downlink_volume == 250);
+    CHECK(last.usage_report[0].rep_trigger.volume_threshold);
+    CHECK(!last.usage_report[0].rep_trigger.volume_quota);
+    CHECK(acc->quota.limit == 1000 && acc->quota.deadline == deadline);
+    CHECK(packet(&sess, &pdr, 200, true));
+    CHECK(reports == 2 && last.usage_report[0].seqn == 1);
+    CHECK(last.usage_report[0].vol_measurement.total_volume == 200);
+    CHECK(last.usage_report[0].rep_trigger.volume_quota);
+    CHECK(!packet(&sess, &pdr, 100, true));
+    CHECK(!packet(&sess, &pdr, 100, false));
+    CHECK(acc->total_octets == 1050 && reports == 2);
+    CHECK(acc->quota.deadline == deadline);
+    urr.vol_quota.total_volume = 500;
+    upf_quota_install(&sess, &urr, true, false);
+    CHECK(acc->quota.limit == 1550 && acc->quota.deadline == deadline);
+    CHECK(packet(&sess, &pdr, 100, true));
+    urr.vol_threshold.total_volume = 100;
+    upf_quota_report(&sess, &urr);
+    CHECK(reports == 3 && acc->last_report.total_octets == 1150);
+    CHECK(packet(&sess, &pdr, 50, false));
+    urr.vol_quota.total_volume = 100;
+    upf_quota_install(&sess, &urr, true, false);
+    CHECK(acc->quota.limit == 1250); /* 50 bytes already consumed since report. */
+    CHECK(packet(&sess, &pdr, 50, false));
+    CHECK(last.usage_report[0].vol_measurement.total_volume == 100);
+    CHECK(last.usage_report[0].rep_trigger.volume_quota);
+    CHECK(!packet(&sess, &pdr, 1, true));
+    urr.vol_quota.total_volume = 1000;
+    upf_quota_install(&sess, &urr, true, true);
+    before = reports;
+    acc->quota.deadline = ogs_get_monotonic_time() - 1;
+    CHECK(!packet(&sess, &pdr, 50, false));
+    CHECK(reports == before + 1 && last.usage_report[0].rep_trigger.quota_validity_time);
+    CHECK(last.usage_report[0].vol_measurement.total_volume == 0);
+    CHECK(last.usage_report[0].time_of_first_packet == 0 && last.usage_report[0].time_of_last_packet == 0);
+    CHECK(!packet(&sess, &pdr, 50, true) && reports == before + 1);
+    upf_quota_install(&sess, &urr, true, false);
+    CHECK(!upf_quota_allow(&sess, &pdr, true)); /* Volume alone cannot un-expire time. */
+    upf_quota_install(&sess, &urr, false, true);
+    CHECK(upf_quota_allow(&sess, &pdr, true));
+    qer.gate_status.uplink = OGS_PFCP_GATE_CLOSE;
+    CHECK(!packet(&sess, &pdr, 10, true));
+    CHECK(acc->total_octets == 1250);
+    qer.gate_status.uplink = OGS_PFCP_GATE_OPEN;
+    far.apply_action = OGS_PFCP_APPLY_ACTION_BUFF;
+    CHECK(!packet(&sess, &pdr, 10, false));
+    far.apply_action = OGS_PFCP_APPLY_ACTION_FORW;
+    far.gnode = NULL;
+    CHECK(!packet(&sess, &pdr, 10, false));
+    far.gnode = &gnode;
+    urr.vol_quota.total_volume = 0;
+    upf_quota_install(&sess, &urr, true, false);
+    CHECK(!upf_quota_allow(&sess, &pdr, true));
+    CHECK(acc->total_octets == 1250);
+    urr.vol_quota.total_volume = 100;
+    upf_quota_install(&sess, &urr, true, true);
+    transport_error = true;
+    CHECK(packet(&sess, &pdr, 100, true));
+    CHECK(acc->last_report.total_octets == 1250 && acc->total_octets == 1350);
+    CHECK(!upf_quota_allow(&sess, &pdr, false));
+    transport_error = false;
+    CHECK(!upf_quota_allow(&sess, &pdr, false));
+    CHECK(last.usage_report[0].vol_measurement.total_volume == 100);
+    CHECK(acc->last_report.total_octets == 1350);
+    CHECK(upf_quota_controlled(&sess, &pdr));
+    upf_quota_cancel_timers(&sess);
+    CHECK(acc->t_validity_time == NULL && acc->quota.expired);
+    CHECK(!upf_quota_allow(&sess, &pdr, true));
+    urr.vol_quota.flags = 0;
+    upf_quota_install(&sess, &urr, true, false);
+    CHECK(!acc->quota.active && acc->t_validity_time == NULL);
+    CHECK(!upf_quota_controlled(&sess, &pdr));
+    CHECK(upf_quota_allow(&sess, &pdr, true));
+    ogs_timer_mgr_destroy(ogs_app()->timer_mgr);
+    ogs_app()->timer_mgr = NULL;
+    ogs_core_terminate();
+    printf("Native UPF quota checks passed: %d\n", checks);
+    return 0;
+}
diff --git a/src/upf/quota.c b/src/upf/quota.c
new file mode 100644
index 0000000..050c94b
--- /dev/null
+++ b/src/upf/quota.c
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Experimental total-volume quota enforcement, TS 29.244 Rel16 5.2.2.2.1.
+ * Counters measure admitted IP packets, not delivery confirmed by the receiver.
+ * The packet crossing the quota is admitted whole: overshoot < one IP packet.
+ */
+#include "context.h"
+#include "pfcp-path.h"
+
+bool upf_quota_controlled(upf_sess_t *sess, ogs_pfcp_pdr_t *pdr)
+{
+    int i;
+    if (!upf_self()->charging_enforcement) return false;
+    for (i = 0; i < pdr->num_of_urr; i++)
+        if (sess->urr_acc[pdr->urr[i]->id-1].quota.active) return true;
+    return false;
+}
+
+void upf_quota_forward_buffered(upf_sess_t *sess, ogs_pfcp_pdr_t *pdr)
+{
+    ogs_pfcp_far_t *far = pdr->far;
+    int i;
+    if (!upf_quota_controlled(sess, pdr)) {
+        ogs_pfcp_send_buffered_gtpu(pdr);
+        return;
+    }
+    /* A quota added to an existing PDR must not allow a legacy buffer flush
+     * to bypass admission. Buffered delivery is outside this initial profile. */
+    if (!far) return;
+    for (i = 0; i < far->num_of_buffered_gtpu; i++) {
+        ogs_pkbuf_free(far->buffered_gtpu[i]);
+        far->buffered_gtpu[i] = NULL;
+    }
+    far->num_of_buffered_gtpu = 0;
+}
+
+void upf_quota_cancel_timers(upf_sess_t *sess)
+{
+    int i;
+    for (i = 0; i < OGS_MAX_NUM_OF_URR; i++) {
+        upf_sess_urr_acc_t *acc = &sess->urr_acc[i];
+        if (!acc->quota.active) continue;
+        if (acc->t_validity_time) {
+            ogs_timer_delete(acc->t_validity_time);
+            acc->t_validity_time = NULL;
+        }
+        if (acc->t_time_quota) {
+            ogs_timer_delete(acc->t_time_quota);
+            acc->t_time_quota = NULL;
+        }
+        if (acc->t_time_threshold) {
+            ogs_timer_delete(acc->t_time_threshold);
+            acc->t_time_threshold = NULL;
+        }
+        acc->quota.expired = true;
+    }
+}
+
+void upf_quota_report(upf_sess_t *sess, ogs_pfcp_urr_t *urr)
+{
+    upf_sess_urr_acc_t *acc = &sess->urr_acc[urr->id-1];
+    ogs_pfcp_user_plane_report_t report;
+    bool exhausted = acc->total_octets >= acc->quota.limit;
+    bool threshold = urr->rep_triggers.volume_threshold && urr->vol_threshold.tovol &&
+        acc->total_octets - acc->last_report.total_octets >= urr->vol_threshold.total_volume;
+    if (!acc->quota.active ||
+            (!(exhausted && !acc->quota.volume_reported) &&
+             !(acc->quota.expired && !acc->quota.expiry_reported) && !threshold)) return;
+    memset(&report, 0, sizeof(report));
+    upf_sess_urr_acc_fill_usage_report(sess, urr, &report, 0);
+    report.num_of_usage_report = 1;
+    if (upf_pfcp_send_session_report_request(sess, &report) != OGS_OK) {
+        ogs_error("Quota report could not be queued; gate remains closed on exhaustion");
+        return; /* Preserve usage for a later report/final deletion report. */
+    }
+    upf_sess_urr_acc_snapshot(sess, urr);
+    acc->quota.volume_reported |= exhausted;
+    acc->quota.expiry_reported |= acc->quota.expired;
+}
+
+static void quota_expired(void *data)
+{
+    ogs_pfcp_urr_t *urr = data;
+    upf_sess_t *sess = UPF_SESS(urr->sess);
+    upf_sess_urr_acc_t *acc = &sess->urr_acc[urr->id-1];
+    acc->quota.expired = true;
+    upf_quota_report(sess, urr);
+}
+
+void upf_quota_install(upf_sess_t *sess, ogs_pfcp_urr_t *urr,
+        bool volume_changed, bool validity_changed)
+{
+    upf_sess_urr_acc_t *acc = &sess->urr_acc[urr->id-1];
+    if (!upf_self()->charging_enforcement) return;
+    if (!urr->vol_quota.tovol) {
+        if (acc->quota.active && acc->t_validity_time) {
+            ogs_timer_delete(acc->t_validity_time);
+            acc->t_validity_time = NULL;
+        }
+        memset(&acc->quota, 0, sizeof(acc->quota));
+        return;
+    }
+    if (!acc->quota.active) {
+        volume_changed = validity_changed = true;
+        acc->time_start = ogs_time_ntp32_now();
+        /* Replace the legacy report-period timer, never retain its callback. */
+        if (acc->t_validity_time) {
+            ogs_timer_delete(acc->t_validity_time);
+            acc->t_validity_time = NULL;
+        }
+    }
+    acc->quota.active = true;
+    if (volume_changed) {
+        /* A new quota applies to usage since the LAST REPORT, including packets
+         * already admitted while the SMF was obtaining this replacement quota. */
+        if (UINT64_MAX - acc->last_report.total_octets < urr->vol_quota.total_volume)
+            acc->quota.limit = acc->total_octets; /* overflow: fail closed */
+        else
+            acc->quota.limit = acc->last_report.total_octets + urr->vol_quota.total_volume;
+        acc->quota.volume_reported = false;
+    }
+    if (validity_changed) {
+        acc->quota.expired = false;
+        acc->quota.expiry_reported = false;
+        acc->quota.deadline = 0;
+        if (acc->t_validity_time) ogs_timer_stop(acc->t_validity_time);
+        if (urr->quota_validity_time) {
+            acc->quota.deadline = ogs_get_monotonic_time() + ogs_time_from_sec(urr->quota_validity_time);
+            if (!acc->t_validity_time)
+                acc->t_validity_time = ogs_timer_add(ogs_app()->timer_mgr, quota_expired, urr);
+            ogs_assert(acc->t_validity_time);
+            ogs_timer_start(acc->t_validity_time, ogs_time_from_sec(urr->quota_validity_time));
+        }
+    }
+    /* A zero or already consumed replacement quota reports outstanding usage. */
+    if (acc->total_octets >= acc->quota.limit) upf_quota_report(sess, urr);
+}
+
+bool upf_quota_allow(upf_sess_t *sess, ogs_pfcp_pdr_t *pdr, bool uplink)
+{
+    int i;
+    bool controlled = false, allowed = true;
+    if (!upf_self()->charging_enforcement) return true;
+    for (i = 0; i < pdr->num_of_urr; i++) {
+        ogs_pfcp_urr_t *urr = pdr->urr[i];
+        upf_sess_urr_acc_t *acc = &sess->urr_acc[urr->id-1];
+        if (!acc->quota.active) continue;
+        controlled = true;
+        if (acc->quota.deadline && ogs_get_monotonic_time() >= acc->quota.deadline)
+            acc->quota.expired = true;
+        if (acc->quota.expired || acc->total_octets >= acc->quota.limit) {
+            upf_quota_report(sess, urr);
+            allowed = false;
+        }
+    }
+    if (!controlled) return true;
+    /* This initial charging profile does not support buffered/idle-mode DL.
+     * Reject it before accounting; otherwise a later flush bypasses quota checks. */
+    if (!pdr->far || !(pdr->far->apply_action & OGS_PFCP_APPLY_ACTION_FORW)) return false;
+    if (!uplink && !pdr->far->gnode) return false;
+    if (pdr->qer && (uplink ? pdr->qer->gate_status.uplink :
+                pdr->qer->gate_status.downlink) != OGS_PFCP_GATE_OPEN) return false;
+    return allowed;
+}
diff --git a/src/smf/chf-accounting.c b/src/smf/chf-accounting.c
new file mode 100644
--- /dev/null
+++ b/src/smf/chf-accounting.c
@@ -0,0 +1,245 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * Bounded PFCP evidence queue and durable Nchf recovery journal.
+ * No shell/network replay here: uncertain sessions require reconciliation.
+ */
+#include "chf-path.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+/* Per-NF, append-only allocator: persist BEFORE exposing a chargingId.
+ * No random 32-bit collision and no reuse on normal process restarts. A torn
+ * record, exhausted range or inaccessible state blocks Create, never resets. */
+int smf_chf_allocate_id(const char *nf_id, uint32_t *value)
+{
+    ogs_uuid_t uuid;
+    struct stat st;
+    char filename[80], record[12], canonical[OGS_UUID_FORMATTED_LENGTH + 1];
+    uint64_t previous = 0;
+    int directory = -1, fd = -1, result = OGS_ERROR;
+    size_t written = 0;
+    if (!nf_id || ogs_uuid_parse(&uuid, nf_id) != OGS_OK) return OGS_ERROR;
+    ogs_uuid_format(canonical, &uuid);
+    directory = open(smf_self()->chf_config.journal_dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW);
+    if (directory < 0 || fstat(directory, &st) || st.st_uid != geteuid() || (st.st_mode & 0077)) goto done;
+    ogs_snprintf(filename, sizeof(filename), "charging-id-%s", canonical);
+    fd = openat(directory, filename, O_RDWR | O_CREAT | O_APPEND | O_NOFOLLOW, 0600);
+    if (fd < 0 || flock(fd, LOCK_EX | LOCK_NB) || fstat(fd, &st) ||
+            !S_ISREG(st.st_mode) || st.st_uid != geteuid() || (st.st_mode & 0077) ||
+            st.st_nlink != 1 || st.st_size < 0 || st.st_size % 11) goto done;
+    if (st.st_size) {
+        if (pread(fd, record, 11, st.st_size - 11) != 11 || record[10] != '\n') goto done;
+        for (int i = 0; i < 10; i++) {
+            if (record[i] < '0' || record[i] > '9') goto done;
+            previous = previous * 10 + record[i] - '0';
+        }
+        if (previous != (uint64_t)st.st_size / 11) goto done;
+    }
+    if (previous >= UINT32_MAX) goto done;
+    ogs_snprintf(record, sizeof(record), "%010" PRIu64 "\n", previous + 1);
+    while (written < 11) {
+        ssize_t n = write(fd, record + written, 11 - written);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) goto done;
+        written += n;
+    }
+    if (fsync(fd) || fsync(directory)) goto done;
+    *value = (uint32_t)(previous + 1);
+    result = OGS_OK;
+done:
+    if (fd >= 0) close(fd);
+    if (directory >= 0) close(directory);
+    return result;
+}
+
+int smf_chf_journal_open(smf_chf_sess_t *chf)
+{
+    const char *directory = smf_self()->chf_config.journal_dir;
+    struct stat st;
+    ogs_uuid_t uuid;
+    char id[OGS_UUID_FORMATTED_LENGTH + 1];
+    int dir;
+    if (!directory) return OGS_ERROR;
+    if (mkdir(directory, 0700) && errno != EEXIST) return OGS_ERROR;
+    dir = open(directory, O_RDONLY | O_DIRECTORY | O_NOFOLLOW);
+    if (dir < 0) return OGS_ERROR;
+    if (fstat(dir, &st) || st.st_uid != geteuid() || (st.st_mode & 0077)) {
+        close(dir); return OGS_ERROR;
+    }
+    ogs_uuid_get(&uuid);
+    ogs_uuid_format(id, &uuid);
+    chf->journal_fd = openat(dir, id, O_WRONLY | O_CREAT | O_EXCL | O_APPEND | O_NOFOLLOW, 0600);
+    if (chf->journal_fd < 0) { close(dir); return OGS_ERROR; }
+    chf->journal_path = ogs_msprintf("%s/%s", directory, id);
+    /* Recovery may inspect/replay only after the last native owner exits. */
+    if (flock(chf->journal_fd, LOCK_EX | LOCK_NB)) { close(dir); return OGS_ERROR; }
+    if (fsync(dir)) { close(dir); return OGS_ERROR; }
+    close(dir);
+    return OGS_OK;
+}
+
+int smf_chf_journal(smf_chf_sess_t *chf, const char *event,
+        const char *uri, const char *body, int status)
+{
+    cJSON *entry;
+    char *json, *line;
+    size_t len, done = 0;
+    ssize_t n;
+    /* Unit fixtures have no journal. Live Create always opens it before I/O. */
+    if (!chf->journal_path) return OGS_OK;
+    entry = cJSON_CreateObject();
+    cJSON_AddStringToObject(entry, "event", event);
+    cJSON_AddNumberToObject(entry, "invocationSequenceNumber", chf->sequence_number);
+    cJSON_AddNumberToObject(entry, "status", status);
+    if (uri) cJSON_AddStringToObject(entry, "uri", uri);
+    if (body) cJSON_AddStringToObject(entry, "body", body);
+    json = cJSON_PrintUnformatted(entry);
+    cJSON_Delete(entry);
+    if (!json) return OGS_ERROR;
+    line = ogs_msprintf("%s\n", json);
+    cJSON_free(json);
+    len = strlen(line);
+    while (done < len) {
+        n = write(chf->journal_fd, line + done, len - done);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        done += n;
+    }
+    ogs_free(line);
+    if (done != len || fsync(chf->journal_fd)) {
+        chf->uncertain = true;
+        ogs_error("CHF durable evidence unavailable; fail closed");
+        return OGS_ERROR;
+    }
+    return OGS_OK;
+}
+
+/* NEW=1, exact retransmission=0, inconsistent/gapped/overflow=-1.
+ * Bounded RAM window: preserve every unconfirmed delta and the last 32
+ * confirmed reports for exact retransmission checks. The durable journal
+ * retains the complete evidence. Old/out-of-window reports fail closed.
+ */
+int smf_chf_record_report(smf_chf_sess_t *chf, uint32_t sequence,
+        uint64_t uplink, uint64_t downlink)
+{
+    unsigned int i;
+    char evidence[160];
+    smf_chf_report_t *report;
+    ogs_snprintf(evidence, sizeof(evidence), "{\"sequence\":%u,\"uplink\":%" PRIu64 ",\"downlink\":%" PRIu64 "}",
+            sequence, uplink, downlink);
+    if (smf_chf_journal(chf, "pfcp_usage", NULL, evidence, 0) != OGS_OK) return OGS_ERROR;
+    for (i = 0; i < chf->report_count; i++) {
+        report = &chf->reports[i];
+        if (report->sequence == sequence) {
+            if (report->uplink == uplink && report->downlink == downlink) return 0;
+            goto inconsistent;
+        }
+    }
+    if (chf->report_count >= SMF_CHF_MAX_REPORTS - 2) {
+        unsigned int confirmed = 0, discard;
+        while (confirmed < chf->report_count && chf->reports[confirmed].confirmed)
+            confirmed++;
+        discard = confirmed > 32 ? confirmed - 32 : 0;
+        if (discard) {
+            memmove(chf->reports, chf->reports + discard,
+                    (chf->report_count - discard) * sizeof(chf->reports[0]));
+            chf->report_count -= discard;
+            memset(chf->reports + chf->report_count, 0,
+                    discard * sizeof(chf->reports[0]));
+        }
+    }
+    if (chf->uncertain || chf->report_count == SMF_CHF_MAX_REPORTS ||
+            uplink > 9007199254740991ULL || downlink > 9007199254740991ULL - uplink ||
+            (!chf->report_count && sequence != 0) ||
+            (chf->report_count && (chf->reports[chf->report_count - 1].sequence == UINT32_MAX ||
+                sequence != chf->reports[chf->report_count - 1].sequence + 1))) goto inconsistent;
+    report = &chf->reports[chf->report_count++];
+    memset(report, 0, sizeof(*report));
+    report->sequence = sequence;
+    report->uplink = uplink;
+    report->downlink = downlink;
+    return 1;
+inconsistent:
+    chf->uncertain = true;
+    chf->closing = true;
+    ogs_warn("CHF usage evidence conflict/gap/limit; reconciliation required");
+    return OGS_ERROR;
+}
+
+/* Select exactly the oldest unconfirmed report. Never aggregate sequence
+ * numbers or retransmit a confirmed delta as a new charging invocation. */
+int smf_chf_next_usage(smf_chf_sess_t *chf, smf_chf_usage_t *usage)
+{
+    unsigned int i;
+    if (!chf || !usage || chf->uncertain || chf->closed || chf->closing)
+        return OGS_ERROR;
+    if (chf->pending) return OGS_DONE;
+    for (i = 0; i < chf->report_count; i++) {
+        smf_chf_report_t *report = &chf->reports[i];
+        if (report->confirmed) continue;
+        if (!report->trigger) return OGS_ERROR;
+        memset(usage, 0, sizeof(*usage));
+        usage->sequence = report->sequence;
+        usage->uplink = report->uplink;
+        usage->downlink = report->downlink;
+        usage->trigger = report->trigger;
+        return OGS_OK;
+    }
+    return OGS_DONE;
+}
+
+int smf_chf_release_body(smf_chf_sess_t *chf, ogs_sbi_request_t *request,
+        smf_chf_transaction_t *transaction)
+{
+    cJSON *root, *unit, *used, *container;
+    char *body, *timestamp;
+    unsigned int i;
+    uint64_t total = 0;
+    if (chf->uncertain || !request || chf->sequence_number == UINT32_MAX) return OGS_ERROR;
+    root = cJSON_Parse(request->http.content);
+    if (!root) return OGS_ERROR;
+    unit = cJSON_GetArrayItem(cJSON_GetObjectItemCaseSensitive(root, "multipleUnitUsage"), 0);
+    if (!cJSON_IsObject(unit)) { cJSON_Delete(root); return OGS_ERROR; }
+    cJSON_DeleteItemFromObjectCaseSensitive(unit, "usedUnitContainer");
+    used = cJSON_AddArrayToObject(unit, "usedUnitContainer");
+    for (i = 0; i < chf->report_count; i++) {
+        smf_chf_report_t *report = &chf->reports[i];
+        if (report->confirmed) continue;
+        if (report->uplink > 9007199254740991ULL - total ||
+                report->downlink > 9007199254740991ULL - total - report->uplink) {
+            cJSON_Delete(root); return OGS_ERROR;
+        }
+        total += report->uplink + report->downlink;
+        container = cJSON_CreateObject();
+        cJSON_AddItemToArray(used, container);
+        cJSON_AddNumberToObject(container, "localSequenceNumber", report->sequence);
+        cJSON_AddNumberToObject(container, "totalVolume", report->uplink + report->downlink);
+        cJSON_AddNumberToObject(container, "uplinkVolume", report->uplink);
+        cJSON_AddNumberToObject(container, "downlinkVolume", report->downlink);
+        cJSON_AddStringToObject(container, "quotaManagementIndicator", "ONLINE_CHARGING");
+        transaction->usage_sequence = report->sequence;
+        transaction->has_usage = true;
+    }
+    if (total > 9007199254740991ULL - chf->consumed_units) { cJSON_Delete(root); return OGS_ERROR; }
+    transaction->used_units = total;
+    cJSON_SetNumberValue(cJSON_GetObjectItemCaseSensitive(root, "invocationSequenceNumber"), chf->sequence_number + 1);
+    timestamp = ogs_sbi_gmtime_string(ogs_time_now());
+    cJSON_ReplaceItemInObjectCaseSensitive(root, "invocationTimeStamp", cJSON_CreateString(timestamp));
+    ogs_free(timestamp);
+    body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) return OGS_ERROR;
+    ogs_free(request->http.content);
+    request->http.content = ogs_strdup(body);
+    request->http.content_length = strlen(body);
+    cJSON_free(body);
+    return OGS_OK;
+}
+
+bool smf_chf_release_confirmed(int status, const ogs_sbi_response_t *response)
+{
+    return status == OGS_OK && response && response->status == 204 &&
+        response->http.content_length == 0;
+}
