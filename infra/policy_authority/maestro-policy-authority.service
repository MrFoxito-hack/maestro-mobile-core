[Unit]
Description=MAEstro independent policy authority and recovery supervisor
After=network.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/maestro-policy-authority/server.py
Restart=always
RestartSec=1
RuntimeDirectory=maestro-policy-authority
RuntimeDirectoryMode=0700
StateDirectory=maestro-policy-authority
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
