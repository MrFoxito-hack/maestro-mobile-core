# Copy to .env; never commit real credentials. Generate separate random secrets.
CHF_DATABASE_PATH=./data/chf.db
CHF_DEFAULT_GRANT_BYTES=10485760
CHF_VALIDITY_TIME_SECONDS=300
CHF_ADMIN_TOKEN=
# UUID keys must match authenticated SMF instance IDs. One distinct token each.
CHF_SBI_TOKENS={}
# Only for an explicitly isolated lab. Does not enable management without auth.
CHF_SBI_LAB_NO_AUTH=false
